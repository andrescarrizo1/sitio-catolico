---
interface Props {
  badge?: string;
  title: string;
  subtitle: string;
  primaryAction?: { label: string; href: string };
  secondaryAction?: { label: string; href: string };
}

const { badge, title, subtitle, primaryAction, secondaryAction } = Astro.props;
---

<section class="relative py-16 sm:py-24 overflow-hidden border-b border-stone-200/80 dark:border-slate-800/80 bg-gradient-to-b from-stone-100/50 via-transparent to-transparent dark:from-slate-900/40 dark:via-transparent dark:to-transparent">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center space-y-6">
    
    {badge && (
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-amber-500/10 text-amber-800 dark:text-amber-300 border border-amber-600/30">
        <span class="w-1.5 h-1.5 rounded-full bg-amber-600 dark:bg-amber-400"></span>
        {badge}
      </div>
    )}

    <h1 class="font-serif text-3xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-slate-950 dark:text-stone-100 leading-[1.15]">
      {title}
    </h1>

    <p class="text-base sm:text-lg lg:text-xl text-stone-600 dark:text-stone-300 leading-relaxed max-w-2xl mx-auto">
      {subtitle}
    </p>

    {(primaryAction || secondaryAction) && (
      <div class="pt-4 flex flex-wrap items-center justify-center gap-3 sm:gap-4">
        {primaryAction && (
          <a
            href={primaryAction.href}
            class="px-5 py-2.5 sm:px-6 sm:py-3 text-sm font-semibold rounded-xl bg-amber-600 text-white shadow-sm hover:bg-amber-700 dark:bg-amber-500 dark:text-slate-950 dark:hover:bg-amber-400 transition-all focus-visible:outline-2 focus-visible:outline-amber-600"
          >
            {primaryAction.label}
          </a>
        )}
        {secondaryAction && (
          <a
            href={secondaryAction.href}
            class="px-5 py-2.5 sm:px-6 sm:py-3 text-sm font-semibold rounded-xl bg-stone-200/70 dark:bg-slate-800 text-stone-800 dark:text-stone-200 hover:bg-stone-300/70 dark:hover:bg-slate-700 transition-all"
          >
            {secondaryAction.label}
          </a>
        )}
      </div>
    )}

  </div>
</section>
