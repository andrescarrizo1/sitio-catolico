---
interface Props {
  reference: string;
  text: string;
  translation?: string;
  reflection?: string;
}

const {
  reference,
  text,
  translation = 'Biblia Torres Amat (1825, Dominio Público)',
  reflection
} = Astro.props;
---

<figure class="my-8 pl-5 sm:pl-6 border-l-4 border-amber-600 dark:border-amber-400 bg-stone-100/40 dark:bg-slate-900/40 py-4 pr-4 rounded-r-xl">
  <blockquote class="font-reading text-lg sm:text-xl italic text-slate-900 dark:text-stone-100 leading-relaxed m-0">
    &laquo;{text}&raquo;
  </blockquote>
  
  <figcaption class="mt-3 flex flex-wrap items-center justify-between gap-2 text-xs sm:text-sm text-stone-500 dark:text-stone-400">
    <div class="flex items-center gap-2">
      <cite class="font-serif font-bold text-amber-800 dark:text-amber-400 not-italic">
        {reference}
      </cite>
      <span class="text-stone-400 dark:text-stone-600">&middot;</span>
      <span class="text-xs text-stone-500">{translation}</span>
    </div>

    <!-- Botón de copiado discreto -->
    <button
      type="button"
      class="copy-verse-btn px-2.5 py-1 rounded bg-stone-200/60 dark:bg-slate-800 hover:bg-amber-600/10 hover:text-amber-700 dark:hover:text-amber-400 text-xs transition-colors"
      data-text={`«${text}» (${reference})`}
      title="Copiar pasaje bíblico"
    >
      Copiar cita
    </button>
  </figcaption>

  {reflection && (
    <div class="mt-4 pt-3 border-t border-stone-200 dark:border-slate-800 text-sm text-stone-600 dark:text-stone-300 font-sans not-italic">
      <strong>Meditación:</strong> {reflection}
    </div>
  )}
</figure>

<script is:inline>
  document.querySelectorAll('.copy-verse-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const text = btn.getAttribute('data-text');
      if (text) {
        try {
          await navigator.clipboard.writeText(text);
          const originalText = btn.textContent;
          btn.textContent = '¡Copiado!';
          setTimeout(() => {
            btn.textContent = originalText;
          }, 2000);
        } catch (e) {
          console.error('Error al copiar texto al portapapeles', e);
        }
      }
    });
  });
</script>
