---
interface Props {
  title: string;
  description?: string;
  url?: string;
}

const { title, url } = Astro.props;

const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : (import.meta.env.PUBLIC_SITE_URL || 'https://razonyasombro.com');
const currentUrl = url || (Astro.url ? new URL(Astro.url.pathname, siteUrl).toString() : siteUrl);

const shareText = `«${title}» — Razón y Asombro`;
const whatsappUrl = `https://api.whatsapp.com/send?text=${encodeURIComponent(shareText + '\n' + currentUrl)}`;
const telegramUrl = `https://t.me/share/url?url=${encodeURIComponent(currentUrl)}&text=${encodeURIComponent(shareText)}`;
---

<div class="my-8 p-5 rounded-2xl bg-stone-100/80 dark:bg-slate-900/80 border border-stone-200 dark:border-slate-800 transition-colors no-print">
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
      <span class="text-xs font-semibold uppercase tracking-wider text-amber-700 dark:text-amber-400">
        Evangelización Digital
      </span>
      <h4 class="font-serif text-base font-bold text-slate-950 dark:text-stone-100">
        Comparte este estudio con tu comunidad
      </h4>
      <p class="text-xs text-stone-600 dark:text-stone-400 mt-0.5">
        Ayuda a difundir la verdad de la fe católica con rigor y sin sensacionalismos.
      </p>
    </div>

    <!-- Botones de Redes Sociales y Acciones -->
    <div class="flex flex-wrap items-center gap-2">
      <!-- Botón Nativo de Compartir (Web Share API para móviles) -->
      <button
        type="button"
        id="native-share-btn"
        data-title={title}
        data-url={currentUrl}
        class="hidden inline-flex items-center gap-2 px-3.5 py-2 text-xs font-semibold rounded-lg bg-amber-600 text-white hover:bg-amber-700 shadow-sm transition-all"
        aria-label="Compartir"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
        </svg>
        Compartir
      </button>

      <!-- WhatsApp -->
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-3.5 py-2 text-xs font-semibold rounded-lg bg-emerald-600 text-white hover:bg-emerald-700 shadow-sm transition-all hover:scale-[1.02] active:scale-[0.98]"
        aria-label="Compartir en WhatsApp"
      >
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.694.06-2.007-.487-1.488-.621-2.435-2.146-2.51-2.246-.075-.099-.607-.808-.607-1.543s.385-1.109.522-1.259c.137-.149.301-.187.401-.187.101 0 .201.002.29.006.096.004.225-.036.35.265.137.327.466 1.139.507 1.222.041.083.069.18.014.288-.055.108-.083.175-.164.271-.082.096-.173.216-.247.289-.083.082-.169.171-.073.336.096.166.427.705.916 1.141.63.561 1.162.735 1.327.818.165.083.262.069.359-.042.096-.111.413-.481.523-.647.11-.166.22-.138.371-.083.151.055.961.453 1.126.536.165.083.275.124.316.193.041.07.041.405-.103.81zM12 2C6.477 2 2 6.477 2 12c0 1.891.526 3.66 1.442 5.176L2 22l4.981-1.306A9.957 9.957 0 0012 22c5.523 0 10-4.477 10-10S17.523 2 12 2z"/>
        </svg>
        WhatsApp
      </a>

      <!-- Telegram -->
      <a
        href={telegramUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-3.5 py-2 text-xs font-semibold rounded-lg bg-sky-600 text-white hover:bg-sky-700 shadow-sm transition-all hover:scale-[1.02] active:scale-[0.98]"
        aria-label="Compartir en Telegram"
      >
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 00-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.74-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .38z"/>
        </svg>
        Telegram
      </a>

      <!-- Copiar Enlace -->
      <button
        type="button"
        id="copy-link-btn"
        data-url={currentUrl}
        class="inline-flex items-center gap-2 px-3.5 py-2 text-xs font-semibold rounded-lg bg-stone-200 dark:bg-slate-800 text-stone-800 dark:text-stone-200 hover:bg-stone-300 dark:hover:bg-slate-700 border border-stone-300/60 dark:border-slate-700 shadow-sm transition-all active:scale-[0.98]"
        aria-label="Copiar enlace al portapapeles"
      >
        <svg id="copy-icon" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
        </svg>
        <svg id="check-icon" class="w-4 h-4 hidden text-emerald-600 dark:text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
        </svg>
        <span id="copy-text">Copiar</span>
      </button>

      <!-- Imprimir / Guardar en PDF -->
      <button
        type="button"
        onclick="window.print()"
        class="inline-flex items-center gap-1.5 px-3 py-2 text-xs font-semibold rounded-lg bg-stone-200 dark:bg-slate-800 text-stone-700 dark:text-stone-300 hover:bg-stone-300 dark:hover:bg-slate-700 border border-stone-300/60 dark:border-slate-700 transition-colors"
        title="Imprimir estudio o guardar en PDF"
      >
        <span>🖨️</span>
        <span class="hidden sm:inline">PDF</span>
      </button>
    </div>
  </div>
</div>

<script>
  const copyBtn = document.getElementById('copy-link-btn');
  const copyIcon = document.getElementById('copy-icon');
  const checkIcon = document.getElementById('check-icon');
  const copyText = document.getElementById('copy-text');
  const shareBtn = document.getElementById('native-share-btn');

  // Si el navegador soporta Web Share API (móviles iOS/Android), mostrar botón nativo
  if (typeof navigator !== 'undefined' && navigator.share && shareBtn) {
    shareBtn.classList.remove('hidden');
    shareBtn.addEventListener('click', async () => {
      const title = shareBtn.getAttribute('data-title') || document.title;
      const url = shareBtn.getAttribute('data-url') || window.location.href;
      try {
        await navigator.share({
          title,
          text: `«${title}» — Razón y Asombro`,
          url,
        });
        if (typeof (window as any).trackGAEvent === 'function') {
          (window as any).trackGAEvent('share', {
            method: 'web_share',
            content_type: 'article',
            item_id: url,
          });
        }
      } catch (err) {
        // Usuario canceló compartir o no soportado
      }
    });
  }

  copyBtn?.addEventListener('click', async () => {
    const url = copyBtn.getAttribute('data-url') || window.location.href;
    try {
      await navigator.clipboard.writeText(url);
      if (typeof (window as any).trackGAEvent === 'function') {
        (window as any).trackGAEvent('share', {
          method: 'copy_link',
          content_type: 'article',
          item_id: url,
        });
      }

      copyIcon?.classList.add('hidden');
      checkIcon?.classList.remove('hidden');
      if (copyText) copyText.textContent = '¡Copiado!';
      
      setTimeout(() => {
        copyIcon?.classList.remove('hidden');
        checkIcon?.classList.add('hidden');
        if (copyText) copyText.textContent = 'Copiar';
      }, 2500);
    } catch (err) {
      console.error('Error al copiar al portapapeles:', err);
    }
  });

  // Tracking de clics en WhatsApp y Telegram
  document.querySelectorAll('a[aria-label^="Compartir en"]').forEach((link) => {
    link.addEventListener('click', () => {
      const label = link.getAttribute('aria-label') || '';
      const method = label.includes('WhatsApp') ? 'whatsapp' : label.includes('Telegram') ? 'telegram' : 'other';
      if (typeof (window as any).trackGAEvent === 'function') {
        (window as any).trackGAEvent('share', {
          method: method,
          content_type: 'article',
          item_id: window.location.href,
        });
      }
    });
  });
</script>
