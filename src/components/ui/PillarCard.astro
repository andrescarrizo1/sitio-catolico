---
interface Props {
  title: string;
  description: string;
  href: string;
  badge?: string;
  date?: Date;
  status?: string;
}

const { title, description, href, badge, date, status } = Astro.props;
---

<article class="group relative flex flex-col justify-between p-6 rounded-2xl bg-stone-100/60 dark:bg-slate-900/60 border border-stone-200/80 dark:border-slate-800 hover:border-amber-500/50 dark:hover:border-amber-400/50 shadow-sm hover:shadow-md transition-all duration-200">
  <div class="space-y-3">
    
    <div class="flex items-center justify-between gap-2">
      {badge && (
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-amber-500/10 text-amber-800 dark:text-amber-300 border border-amber-500/20">
          {badge}
        </span>
      )}
      {status && (
        <span class="text-[11px] font-medium text-emerald-700 dark:text-emerald-400">
          ✓ {status}
        </span>
      )}
    </div>

    <h3 class="font-serif text-xl sm:text-2xl font-bold text-slate-900 dark:text-stone-100 group-hover:text-amber-700 dark:group-hover:text-amber-400 transition-colors m-0">
      <a href={href} class="focus-visible:outline-none">
        <span class="absolute inset-0" aria-hidden="true"></span>
        {title}
      </a>
    </h3>

    <p class="text-sm text-stone-600 dark:text-stone-300 leading-relaxed line-clamp-3 m-0">
      {description}
    </p>

  </div>

  <div class="mt-6 pt-4 border-t border-stone-200/60 dark:border-slate-800/60 flex items-center justify-between text-xs text-stone-500 dark:text-stone-400">
    {date && (
      <time datetime={date.toISOString()}>
        {date.toLocaleDateString('es-ES', { year: 'numeric', month: 'short', day: 'numeric' })}
      </time>
    )}
    <span class="font-semibold text-amber-700 dark:text-amber-400 flex items-center gap-1 group-hover:translate-x-0.5 transition-transform">
      Leer estudio &rarr;
    </span>
  </div>
</article>
