---
import GoogleAnalytics from './GoogleAnalytics.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  articleDate?: Date;
  articleModified?: Date;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  lang?: 'es' | 'en';
  alternateLinks?: { href: string; hreflang: string }[];
  preloadImage?: string;
}

const {
  title,
  description,
  image = '/og-default.jpg',
  articleDate,
  articleModified,
  ogType = 'website',
  noindex = false,
  lang = 'es',
  alternateLinks = [],
  preloadImage,
} = Astro.props;

const siteBrand = 'Razón y Asombro';

const knownShortTitles: Record<string, string> = {
  'El Bureau Médical de Lourdes: El Tribunal Científico más Riguroso del Mundo y los 7 Criterios Médicos': 'El Bureau Médical de Lourdes',
  'La Sábana Santa de Turín: STURP, carbono 14 y qué dicen los estudios científicos': 'La Sábana Santa de Turín',
  'La Tilma de Guadalupe: El Ayate Incorrupto, los Pigmentos Inexplicables y el Fenómeno Ocular': 'La Tilma de Guadalupe',
  'El Milagro del Sol (Fátima, 13 de Octubre de 1917): Historia, Testimonios y Prensa Secular': 'El Milagro del Sol',
  'La Parábola del Buen Samaritano: El Amor al Prójimo sin Fronteras': 'El Buen Samaritano',
  'El Signo Eucarístico de Buenos Aires (1996): El Análisis Ciego del Cardiólogo Frederic Zugibe': 'Milagro de Buenos Aires (1996)',
  'El Milagro Eucarístico de Lanciano: Historia y Evidencia Científica': 'Milagro Eucarístico de Lanciano',
  'El Milagro Eucarístico de Sokółka (2008): La Fusión Microscópica de Pan y Tejido Cardíaco': 'Milagro Eucarístico de Sokółka',
  'San Carlo Acutis: El Apóstol de la Eucaristía, los Milagros y la Red': 'San Carlo Acutis',
  'Padre Pío: Los Peritajes Médicos de sus Estigmas y los Decretos del Santo Oficio': 'Estigmas del Padre Pío',
  'Santa Faustina Kowalska: Las Visiones de Jesús, el Diario y el Retrato de Vilna': 'Santa Faustina Kowalska',
  'Esperanza y Fortaleza en el Sufrimiento | Versículos Bíblicos y Meditación': 'Esperanza en el Sufrimiento',
  'Esperanza y Fortaleza en el Sufrimiento': 'Esperanza en el Sufrimiento',
  'Acerca de Razón y Asombro | Misión, Principios y Fidelidad Eclesial': 'Misión y Principios',
  'El Escudo de la Fe | Respuestas Bíblicas a Objeciones Católicas': 'El Escudo de la Fe',
  'Biblia y Conversión: Versículos por Temas Espirituales': 'Biblia y Conversión',
  'Ciencia y Fe Católica: Evidencia Empírica y Forense': 'Ciencia y Fe Católica',
  'Consuelo Espiritual y Paz para el Alma': 'Consuelo Espiritual',
  'Contacto e Intenciones de Oración': 'Contacto e Intenciones',
  'Jesús y sus Enseñanzas: Evangelio y Parábolas': 'Jesús y sus Enseñanzas',
  'Metodología Editorial y Criterios de Verificación': 'Metodología Editorial',
  'Milagros Eucarísticos y Ciencia | Peritajes Médicos e Históricos': 'Milagros Eucarísticos y Ciencia',
  'Muro de Oración y Comunión de los Santos': 'Muro de Oración',
  'San Pío de Pietrelcina: Vida, Estigmas y Espiritualidad': 'San Pío de Pietrelcina',
  'Cómo Rezar el Santo Rosario Paso a Paso | Guía Completa para Principiantes': 'Cómo Rezar el Santo Rosario',
  'Santo Rosario Interactivo con Visor Visual de Cuentas': 'Santo Rosario Interactivo',
  '¿Qué Misterios tocan Hoy en el Rosario? | Asignación Diaria y Rezo Guiado': 'Misterios de Hoy en el Rosario',
  'Santos y Místicos de la Iglesia Católica: Fe, Ciencia y Caridad': 'Santos y Místicos',
  'Virgen de Fátima: Historia, Mensaje y Milagro del Sol': 'Virgen de Fátima',
  'Responsable Editorial y Equipo': 'Equipo Editorial',
  'Página no encontrada (404)': 'Página no encontrada (404)',
  'Fe Católica, Evangelio y Rigor Documental': 'Fe Católica y Evangelio',
  'The Chaplet of Divine Mercy: Prayers, Promises & History': 'Chaplet of Divine Mercy',
  'The Chaplet of Divine Mercy: Prayers, Promises &amp; History': 'Chaplet of Divine Mercy',
  'Catholic Faith, Historical Rigor & Science': 'Catholic Faith and Science',
  'Reason & Wonder | Catholic Faith, Historical Rigor & Science': 'Catholic Faith and Science',
  'Reason &amp; Wonder | Catholic Faith, Historical Rigor &amp; Science': 'Catholic Faith and Science',
  'Catholic Faith & Science': 'Catholic Faith and Science',
  'Catholic Faith &amp; Science': 'Catholic Faith and Science',
  'Interactive Catholic Rosary & Bead Visualizer': 'Interactive Rosary',
  'Interactive Catholic Rosary &amp; Bead Visualizer': 'Interactive Rosary',
  'How to Pray the Rosary Step by Step: Complete Beginner Guide': 'How to Pray the Rosary',
  'The Shroud of Turin: STURP, Carbon-14, and Modern Scientific Studies': 'The Shroud of Turin',
};

let cleanTitle = title.trim();
cleanTitle = cleanTitle.replace(/\s*\|\s*(Razón y Asombro|Reason & Wonder|Reason &amp; Wonder)[\s|]*$/i, '').trim();
cleanTitle = cleanTitle.replace(/^Razón y Asombro\s*\|\s*/i, '').trim();

if (knownShortTitles[cleanTitle]) {
  cleanTitle = knownShortTitles[cleanTitle];
} else {
  if (cleanTitle.includes('|')) cleanTitle = cleanTitle.split('|')[0].trim();
  if (cleanTitle.length > 41 && cleanTitle.includes(':')) {
    const beforeColon = cleanTitle.split(':')[0].trim();
    if (beforeColon.length <= 41) cleanTitle = beforeColon;
  }
  if (cleanTitle.length > 41) {
    const sub = cleanTitle.slice(0, 41);
    const lastSpace = sub.lastIndexOf(' ');
    cleanTitle = (lastSpace > 15 ? sub.slice(0, lastSpace) : sub).replace(/[,.:;–—-]+$/, '').trim();
  }
}

const fullTitle = `${cleanTitle} | ${siteBrand}`;
const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : (import.meta.env.PUBLIC_SITE_URL || 'https://razonyasombro.com');
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
const ogImageURL = new URL(image, siteUrl);
const allowIndexing = (import.meta.env.PROD || import.meta.env.PUBLIC_ALLOW_INDEXING === 'true') && !noindex;
let metaDescription = description.trim().replace(/\s+/g, ' ');
if (metaDescription.length > 155) {
  const truncated = metaDescription.slice(0, 155);
  const lastSpace = truncated.lastIndexOf(' ');
  metaDescription = (lastSpace > 115 ? truncated.slice(0, lastSpace) : truncated).replace(/[,.:;–—-]+$/, '').trim();
}
---

<!-- Configuración esencial -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="manifest" href="/manifest.json" />
<meta name="generator" content={Astro.generator} />

<!-- Canónica -->
<link rel="canonical" href={canonicalURL} />

{preloadImage && (
  <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />
)}

<!-- Etiquetas hreflang recíprocas para internacionalización -->
{alternateLinks && alternateLinks.map((alt) => (
  <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
))}

<!-- Título y Descripción -->
<title>{fullTitle}</title>
<meta name="title" content={fullTitle} />
<meta name="description" content={metaDescription} />

<!-- Control estricto de indexación -->
{allowIndexing ? (
  <meta name="robots" content="index, follow" />
) : (
  <meta name="robots" content="noindex, follow" />
)}

<!-- Open Graph / Redes Sociales -->
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={metaDescription} />
<meta property="og:image" content={ogImageURL} />
<meta property="og:locale" content={lang === 'en' ? 'en_US' : 'es'} />
<meta property="og:site_name" content={siteBrand} />

{articleDate && (
  <meta property="article:published_time" content={articleDate.toISOString()} />
)}
{articleModified && (
  <meta property="article:modified_time" content={articleModified.toISOString()} />
)}

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={metaDescription} />
<meta name="twitter:image" content={ogImageURL} />

<!-- Tipografía de Google Fonts optimizada con font-display: swap (asíncrona) -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  rel="preload"
  as="style"
  href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700;800&family=Lora:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
/>
<link
  id="google-fonts-stylesheet"
  href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700;800&family=Lora:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
  rel="stylesheet"
  media="print"
/>
<script is:inline>
  const fontSheet = document.getElementById('google-fonts-stylesheet');
  if (fontSheet) {
    fontSheet.addEventListener('load', function() { this.media = 'all'; });
  }
</script>
<noscript>
  <link
    href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700;800&family=Lora:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
    rel="stylesheet"
  />
</noscript>

<!-- Google Analytics 4 (GA4) -->
<GoogleAnalytics />

<!-- Script de prevención de parpadeo de modo oscuro (FOUC) -->
<script is:inline>
  const savedTheme = localStorage.getItem('theme');
  const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
  if (savedTheme === 'dark' || (!savedTheme && prefersDark)) {
    document.documentElement.classList.add('dark');
  } else {
    document.documentElement.classList.remove('dark');
  }
</script>
