---
interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  crumbs: Crumb[];
}

const { crumbs } = Astro.props;

const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : (import.meta.env.PUBLIC_SITE_URL || 'http://localhost:4321');

const schemaItems = [
  {
    '@type': 'ListItem',
    position: 1,
    name: 'Inicio',
    item: siteUrl,
  },
  ...crumbs.map((crumb, idx) => ({
    '@type': 'ListItem',
    position: idx + 2,
    name: crumb.label,
    ...(crumb.href ? { item: new URL(crumb.href, siteUrl).toString() } : {}),
  })),
];

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: schemaItems,
};
---

<nav aria-label="Miga de pan" class="py-4 text-xs sm:text-sm text-stone-500 dark:text-stone-400">
  <ol class="flex flex-wrap items-center gap-1.5 sm:gap-2">
    <li>
      <a href="/" class="hover:text-amber-700 dark:hover:text-amber-400 transition-colors">
        Inicio
      </a>
    </li>
    {crumbs.map((crumb, idx) => {
      const isLast = idx === crumbs.length - 1;
      return (
        <li class="flex items-center gap-1.5 sm:gap-2">
          <span class="text-stone-400 dark:text-stone-600" aria-hidden="true">&rsaquo;</span>
          {crumb.href && !isLast ? (
            <a href={crumb.href} class="hover:text-amber-700 dark:hover:text-amber-400 transition-colors">
              {crumb.label}
            </a>
          ) : (
            <span class="text-stone-800 dark:text-stone-200 font-medium" aria-current="page">
              {crumb.label}
            </span>
          )}
        </li>
      );
    })}
  </ol>
</nav>

<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
