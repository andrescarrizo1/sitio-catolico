---
import type { ImageMetadata } from 'astro';
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/global/Breadcrumbs.astro';
import FactSheet from '../components/ui/FactSheet.astro';
import SourceList from '../components/ui/SourceList.astro';
import NextStep from '../components/ui/NextStep.astro';
import ArticleImage from '../components/ui/ArticleImage.astro';
import ShareButtons from '../components/ui/ShareButtons.astro';
import SupportCard from '../components/ui/SupportCard.astro';
import { getGitCommitDate } from '../utils/getGitDate';

interface Props {
  title: string;
  resumen: string;
  badge?: string;
  crumbs: { label: string; href?: string }[];
  lugar?: string;
  fechaEvento?: string;
  estatusEclesial?: string;
  evidenciaCientifica?: string;
  grupoSanguineo?: string;
  investigadores?: string[];
  laboratorios?: string[];
  estadoReliquias?: string;
  fuentes?: any[];
  sources?: { title: string; url?: string; type: 'primaria' | 'secundaria' }[];
  nextStepVariant?: 'jesus' | 'milagros' | 'fatima' | 'santos' | 'biblia' | 'ciencia';
  fechaPublicacion?: Date | string;
  datePublished?: Date | string;
  fechaRevision?: Date | string;
  lastReviewed?: Date | string;
  autor?: string;
  author?: string;
  revisadoPor?: string;
  reviewedBy?: string;
  evidenceLevel?: string;
  contentFilePath?: string;
  imagen?: {
    src: string;
    alt: string;
    credito?: string;
    licencia?: string;
    url_fuente?: string;
  };
  lang?: 'es' | 'en';
  alternateLinks?: { href: string; hreflang: string }[];
  alternateUrl?: string;
}

const {
  title,
  resumen,
  badge,
  crumbs,
  lugar,
  fechaEvento,
  estatusEclesial,
  evidenciaCientifica,
  grupoSanguineo,
  investigadores = [],
  laboratorios = [],
  estadoReliquias,
  fuentes = [],
  sources = [],
  nextStepVariant = 'ciencia',
  fechaPublicacion,
  datePublished,
  fechaRevision,
  lastReviewed,
  autor,
  author,
  revisadoPor,
  reviewedBy,
  evidenceLevel,
  contentFilePath,
  imagen,
  lang = 'es',
  alternateLinks,
  alternateUrl,
} = Astro.props;

const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : (import.meta.env.PUBLIC_SITE_URL || 'https://razonyasombro.com');
const currentURL = new URL(Astro.url.pathname, siteUrl).toString();

const assetImages = import.meta.glob<{ default: ImageMetadata }>('/src/assets/**/*.{jpeg,jpg,png,gif,webp}', { eager: true });
let resolvedImageSrc = '/og-default.jpg';
if (imagen?.src) {
  const norm = imagen.src.startsWith('/') ? imagen.src : `/${imagen.src}`;
  if (assetImages[norm]) {
    resolvedImageSrc = assetImages[norm].default.src;
  } else {
    resolvedImageSrc = imagen.src;
  }
}
const imageUrl = new URL(resolvedImageSrc, siteUrl).toString();

const effectiveAuthor = (author || autor || '').trim();
const effectiveReviewedBy = (reviewedBy || revisadoPor || '').trim();
const authorSchema = [
  {
    '@type': effectiveAuthor === 'Andrés Carrizo' ? 'Person' : 'Organization',
    name: effectiveAuthor || 'Razón y Asombro',
    url: `${siteUrl}/autor/`,
  },
];

const rawPubDate = datePublished || fechaPublicacion;
const datePublishedIso = rawPubDate ? new Date(rawPubDate).toISOString() : '2026-01-01T00:00:00Z';

const rawRevDate = lastReviewed || fechaRevision;
let formattedRevDate: Date | null = null;
if (rawRevDate) {
  const d = new Date(rawRevDate);
  if (!isNaN(d.getTime())) {
    formattedRevDate = d;
  }
}
const dateModifiedIso = formattedRevDate
  ? formattedRevDate.toISOString()
  : (contentFilePath ? getGitCommitDate(contentFilePath, rawRevDate) : undefined);

const isPlaceholder = (val?: string) => {
  if (!val) return true;
  const lower = val.trim().toLowerCase();
  return lower === '' || lower === 'todo' || lower === 'placeholder' || lower === 'n/a' || lower === 'none';
};

const isConcreteReviewer = (val?: string) => {
  if (!val) return false;
  const lower = val.trim().toLowerCase();
  if (isPlaceholder(val)) return false;
  if (lower.includes('revisión editorial interna') || lower.includes('revision editorial interna')) return false;
  if (lower.includes('equipo editorial')) return false;
  return true;
};

const allSources = (sources && sources.length > 0) ? sources : (fuentes && fuentes.length > 0 ? fuentes : []);

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': currentURL,
  },
  headline: title,
  description: resumen,
  image: [imageUrl],
  url: currentURL,
  datePublished: datePublishedIso,
  dateModified: dateModifiedIso,
  author: authorSchema,
  publisher: {
    '@type': 'Organization',
    name: 'Razón y Asombro',
    url: `${siteUrl}/`,
    logo: {
      '@type': 'ImageObject',
      url: `${siteUrl}/favicon.svg`,
    },
  },
};
---

<BaseLayout
  title={title}
  description={resumen}
  image={imageUrl}
  articleDate={rawPubDate ? new Date(rawPubDate) : undefined}
  articleModified={formattedRevDate ? formattedRevDate : (dateModifiedIso ? new Date(dateModifiedIso) : undefined)}
  ogType="article"
  lang={lang}
  alternateLinks={alternateLinks}
  alternateUrl={alternateUrl}
>
  <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    
    <!-- Miga de Pan -->
    <Breadcrumbs crumbs={crumbs} />

    <!-- Cabecera Editorial -->
    <header class="mt-4 mb-8 space-y-4">
      {badge && (
        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-amber-500/10 text-amber-800 dark:text-amber-300 border border-amber-500/20">
          {badge}
        </span>
      )}

      <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-slate-950 dark:text-stone-100 leading-[1.2]">
        {title}
      </h1>

      <!-- Respuesta directa en las primeras 2-3 líneas (Direct Answer SEO) -->
      <div class="p-4 sm:p-5 rounded-xl bg-stone-100 dark:bg-slate-900 border-l-4 border-amber-600 dark:border-amber-400 text-base sm:text-lg text-stone-700 dark:text-stone-300 leading-relaxed font-reading">
        <strong>Síntesis del hecho:</strong> {resumen}
      </div>

      <!-- Metadatos de autoría y revisión -->
      {(!isPlaceholder(effectiveAuthor) || isConcreteReviewer(effectiveReviewedBy) || formattedRevDate) && (
        <div class="flex flex-wrap items-center gap-4 text-xs text-stone-500 dark:text-stone-400 pt-2 border-b border-stone-200 dark:border-slate-800 pb-4">
          {!isPlaceholder(effectiveAuthor) && <span>Por <strong>{effectiveAuthor}</strong></span>}
          {isConcreteReviewer(effectiveReviewedBy) && (
            <>
              {!isPlaceholder(effectiveAuthor) && <span>&middot;</span>}
              <span>Revisado por: <strong>{effectiveReviewedBy}</strong></span>
            </>
          )}
          {formattedRevDate && (
            <>
              {(!isPlaceholder(effectiveAuthor) || isConcreteReviewer(effectiveReviewedBy)) && <span>&middot;</span>}
              <span>Última revisión: <time datetime={formattedRevDate.toISOString()}>{formattedRevDate.toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' })}</time></span>
            </>
          )}
        </div>
      )}
    </header>

    <!-- Imagen Principal Verificada -->
    {imagen && (
      <ArticleImage
        src={imagen.src}
        alt={imagen.alt}
        credito={imagen.credito}
        licencia={imagen.licencia}
        url_fuente={imagen.url_fuente}
        isMain={true}
      />
    )}

    <!-- Ficha Técnica Resumen (Archival FactSheet) -->
    <FactSheet
      lugar={lugar}
      fecha={fechaEvento}
      estatusEclesial={estatusEclesial}
      evidenciaCientifica={evidenciaCientifica}
      grupoSanguineo={grupoSanguineo}
      investigadores={investigadores}
      laboratorios={laboratorios}
      estadoReliquias={estadoReliquias}
    />

    <!-- Cuerpo del artículo -->
    <div class="prose-editorial mx-auto mt-8">
      <slot />
    </div>

    <!-- Compartir en WhatsApp, Telegram y Copiar Enlace -->
    <ShareButtons title={title} description={resumen} />

    <!-- Bloque Tu Siguiente Paso -->
    <NextStep variant={nextStepVariant} />

    <!-- Módulo de Sostenimiento y Donaciones -->
    <div class="my-8">
      <SupportCard variant="compact" />
    </div>

    <!-- Fuentes Primarias y Documentales -->
    {allSources && allSources.length > 0 && (
      <SourceList fuentes={allSources} />
    )}

  </article>
</BaseLayout>
