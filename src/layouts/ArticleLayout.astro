---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/global/Breadcrumbs.astro';
import NextStep from '../components/ui/NextStep.astro';
import SourceList from '../components/ui/SourceList.astro';
import ArticleImage from '../components/ui/ArticleImage.astro';

interface Props {
  title: string;
  resumen: string;
  badge?: string;
  crumbs: { label: string; href?: string }[];
  nextStepVariant?: 'jesus' | 'milagros' | 'fatima' | 'santos' | 'biblia';
  fuentes?: any[];
  fechaPublicacion?: Date;
  fechaRevision?: Date;
  autor?: string;
  revisadoPor?: string;
  imagen?: {
    src: string;
    alt: string;
    credito: string;
    licencia: string;
    url_fuente: string;
  };
}

const {
  title,
  resumen,
  badge,
  crumbs,
  nextStepVariant = 'jesus',
  fuentes = [],
  fechaPublicacion = new Date('2026-01-01'),
  fechaRevision = new Date('2026-01-01'),
  autor = 'Equipo Editorial',
  revisadoPor = 'Revisión Teológica Interna',
  imagen,
} = Astro.props;

const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : (import.meta.env.PUBLIC_SITE_URL || 'http://localhost:4321');
const currentURL = new URL(Astro.url.pathname, siteUrl).toString();

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: resumen,
  url: currentURL,
  datePublished: fechaPublicacion.toISOString(),
  dateModified: fechaRevision.toISOString(),
  author: {
    '@type': 'Organization',
    name: autor,
    url: siteUrl,
  },
  publisher: {
    '@type': 'Organization',
    name: 'Ad Veritatem',
    url: siteUrl,
  },
};
---

<BaseLayout
  title={title}
  description={resumen}
  articleDate={fechaPublicacion}
  articleModified={fechaRevision}
  ogType="article"
>
  <article class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    
    <Breadcrumbs crumbs={crumbs} />

    <header class="mt-4 mb-8 space-y-4">
      {badge && (
        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-amber-500/10 text-amber-800 dark:text-amber-300 border border-amber-500/20">
          {badge}
        </span>
      )}

      <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-slate-950 dark:text-stone-100 leading-[1.2]">
        {title}
      </h1>

      <p class="text-lg sm:text-xl text-stone-600 dark:text-stone-300 font-reading leading-relaxed">
        {resumen}
      </p>

      <div class="flex flex-wrap items-center gap-4 text-xs text-stone-500 dark:text-stone-400 pt-2 border-b border-stone-200 dark:border-slate-800 pb-4">
        <span>Por <strong>{autor}</strong></span>
        <span>&middot;</span>
        <span>Revisado por: <strong>{revisadoPor}</strong></span>
        <span>&middot;</span>
        <span>Última revisión: <time datetime={fechaRevision.toISOString()}>{fechaRevision.toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' })}</time></span>
      </div>
    </header>

    <!-- Imagen Principal Verificada -->
    {imagen && (
      <ArticleImage
        src={imagen.src}
        alt={imagen.alt}
        credito={imagen.credito}
        licencia={imagen.licencia}
        url_fuente={imagen.url_fuente}
      />
    )}

    <div class="prose-editorial mx-auto">
      <slot />
    </div>

    {nextStepVariant && (
      <NextStep variant={nextStepVariant} />
    )}

    {fuentes && fuentes.length > 0 && (
      <SourceList fuentes={fuentes} />
    )}

  </article>

  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
</BaseLayout>
