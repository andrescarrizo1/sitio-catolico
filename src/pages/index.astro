---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/ui/Hero.astro';
import PillarCard from '../components/ui/PillarCard.astro';
import SupportCard from '../components/ui/SupportCard.astro';

const pillars = [
  {
    title: 'Jesús y sus Enseñanzas',
    description: 'La vida, milagros y parábolas de Nuestro Señor Jesucristo explicadas con fidelidad bíblica e histórica, orientadas a la conversión personal hoy.',
    href: '/jesus/',
    badge: 'Evangelio',
  },
  {
    title: 'Milagros Eucarísticos y Ciencia',
    description: 'Estudios forenses e histopatológicos de Lanciano, Buenos Aires y Sokółka. Miocardio humano en agonía, glóbulos blancos vivos y sangre AB examinados en laboratorio.',
    href: '/milagros-eucaristicos/',
    badge: 'Fisiopatología',
  },
  {
    title: 'Ciencia y Fe Forense',
    description: 'El Santo Sudario de Turín (rayos X WAXS 2024), el ayate de Guadalupe (fenómeno corneal óptico) y los 7 criterios médicos del Bureau de Lourdes.',
    href: '/ciencia-y-fe/',
    badge: 'Evidencia Física',
  },
  {
    title: 'Santos y Místicos',
    description: 'San Carlo Acutis (la Eucaristía como autopista al Cielo), Santa Faustina Kowalska (la Divina Misericordia) y San Pío de Pietrelcina.',
    href: '/santos/',
    badge: 'Santidad Comprobada',
  },
  {
    title: 'Virgen de Fátima',
    description: 'Las apariciones de 1917, el mensaje de oración y penitencia, los tres pastorcitos y la crónica del Milagro del Sol documentada por la prensa laica de la época.',
    href: '/virgen-de-fatima/',
    badge: 'Apariciones',
  },
  {
    title: 'Santo Rosario y Coronilla',
    description: 'Visualizador contemplativo interactivo cuenta por cuenta con seguimiento de cuentas en tiempo real, misterios del día, devociones marianas y modo Coronilla.',
    href: '/rosario/',
    badge: 'Oración PWA',
  },
  {
    title: 'Biblia y Conversión',
    description: 'Pasajes de la Sagrada Escritura en dominio público (Torres Amat 1825) clasificados por temas espirituales: sufrimiento, perdón, duda y esperanza.',
    href: '/biblia/',
    badge: 'Escritura',
  },
  {
    title: 'Consuelo Espiritual y Paz',
    description: 'Refugio doctrinal y bálsamo en la Palabra de Dios y los Santos para el dolor, la pérdida, la angustia y la culpa.',
    href: '/consuelo/',
    badge: 'Refugio del Alma',
  },
  {
    title: 'El Escudo de la Fe (Apologética)',
    description: 'Defensa bíblica y patrística ante objeciones sobre la Virgen María, la Eucaristía, la Confesión, el Purgatorio y el Papa.',
    href: '/apologetica/',
    badge: 'Fides et Ratio',
  },
];

const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : (import.meta.env.PUBLIC_SITE_URL || 'https://razonyasombro.com');

const websiteSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      'url': `${siteUrl}/`,
      'name': 'Razón y Asombro',
      'description': 'Plataforma web católica dedicada a proclamar la verdad de Jesucristo, sus enseñanzas bíblicas y los signos documentados de la fe con el máximo rigor histórico y científico.',
      'inLanguage': 'es',
      'publisher': {
        '@id': `${siteUrl}/#organization`
      }
    },
    {
      '@type': 'Organization',
      '@id': `${siteUrl}/#organization`,
      'name': 'Razón y Asombro',
      'url': `${siteUrl}/`,
      'logo': {
        '@type': 'ImageObject',
        'url': `${siteUrl}/favicon.svg`
      },
      'description': 'Plataforma web católica de divulgación doctrinal, investigación histórica de milagros y oración contemplativa.'
    }
  ]
};

const alternateLinks = [
  { hreflang: 'es', href: `${siteUrl}/` },
  { hreflang: 'en', href: `${siteUrl}/en/` },
  { hreflang: 'x-default', href: `${siteUrl}/` },
];
---

<BaseLayout
  title="Razón y Asombro | Fe Católica, Evangelio y Rigor Documental"
  description="Plataforma católica de doctrina, Sagrada Escritura y rigor documental. Investigaciones históricas de milagros, Santo Rosario interactivo y oración."
  alternateLinks={alternateLinks}
  alternateUrl="/en/"
>
  <!-- Schema.org WebSite y Organization -->
  <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />

  <!-- Hero Principal -->
  <Hero
    badge="Fe Católica &middot; Verdad Revelada"
    title="La belleza del Evangelio. La certeza de los hechos."
    subtitle="Una plataforma católica sin concesiones al relativismo ni al sensacionalismo. Enseñanzas de Jesucristo, peritajes científicos de milagros eucarísticos y contemplación del Santo Rosario."
    primaryAction={{ label: 'Rezar el Rosario de Hoy', href: '/rosario/misterios-de-hoy/' }}
    secondaryAction={{ label: 'Explorar Enseñanzas de Jesús', href: '/jesus/' }}
  />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16 space-y-16">
    
    <!-- 1. Acceso Destacado: Rezar el Rosario Ahora & Guía Contemplativa -->
    <section class="p-6 sm:p-8 rounded-3xl bg-gradient-to-r from-amber-500/15 via-amber-600/10 to-transparent border border-amber-500/30 dark:border-amber-500/20 shadow-sm flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="space-y-2 text-center md:text-left">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-amber-600/10 text-amber-800 dark:text-amber-300 border border-amber-600/20">
          <span class="w-2 h-2 rounded-full bg-amber-600 dark:bg-amber-400 animate-pulse"></span>
          Oración Contemplativa en Vivo
        </div>
        <h2 class="font-serif text-xl sm:text-2xl font-bold text-slate-950 dark:text-stone-100">
          Santo Rosario Interactivo: Rezalo ahora cuenta por cuenta
        </h2>
        <p class="text-sm text-stone-600 dark:text-stone-300 font-reading max-w-2xl">
          Visualizador de cuentas con audio litúrgico, detección del misterio del día, oraciones en español y latín, y funcionamiento offline para orar en cualquier lugar.
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-3 shrink-0">
        <a
          href="/rosario/misterios-de-hoy/"
          class="inline-flex items-center gap-2 px-5 py-3 rounded-xl font-semibold text-sm text-white bg-amber-600 hover:bg-amber-700 transition-all shadow-md shadow-amber-600/20"
        >
          <span>Rezar Rosario de Hoy</span>
          <span>&rarr;</span>
        </a>
        <a
          href="/rosario/como-rezar/"
          class="inline-flex items-center gap-2 px-4 py-3 rounded-xl font-medium text-sm text-stone-700 dark:text-stone-300 bg-stone-200/60 dark:bg-slate-800 hover:bg-stone-200 dark:hover:bg-slate-700 transition-colors"
        >
          Guía paso a paso
        </a>
      </div>
    </section>

    <!-- 2. Investigaciones y Estudios Documentados Destacados -->
    <section class="p-8 sm:p-10 rounded-3xl bg-stone-100/70 dark:bg-slate-900/70 border border-stone-200 dark:border-slate-800">
      <div class="max-w-3xl mb-8 space-y-2">
        <span class="text-xs font-semibold uppercase tracking-wider text-amber-700 dark:text-amber-400">
          Evidencia Rigurosa y Ciencia Forense
        </span>
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-slate-950 dark:text-stone-100">
          Estudios Documentados de la Fase 1
        </h2>
        <p class="text-sm text-stone-600 dark:text-stone-400">
          Textos redactados con nuestra voz editorial, citas primarias contrastadas y datos validados:
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        <a
          href="/santos/carlo-acutis/"
          class="p-5 rounded-2xl bg-white dark:bg-slate-950 border border-stone-200 dark:border-slate-800 hover:border-amber-500/50 transition-all group"
        >
          <span class="text-xs font-semibold text-emerald-700 dark:text-emerald-400 uppercase tracking-wide">Santos &middot; Canonización 2025</span>
          <h3 class="font-serif text-lg font-bold text-slate-950 dark:text-stone-100 group-hover:text-amber-700 dark:group-hover:text-amber-400 mt-1">
            San Carlo Acutis: Apóstol de la Eucaristía &rarr;
          </h3>
          <p class="text-xs text-stone-500 dark:text-stone-400 mt-2 line-clamp-2">
            La vida del ciberapóstol, la exposición mundial de milagros y el dictamen médico de Florencia 2022.
          </p>
        </a>

        <a
          href="/ciencia-y-fe/sabana-santa-de-turin/"
          class="p-5 rounded-2xl bg-white dark:bg-slate-950 border border-stone-200 dark:border-slate-800 hover:border-amber-500/50 transition-all group"
        >
          <span class="text-xs font-semibold text-indigo-700 dark:text-indigo-400 uppercase tracking-wide">Ciencia Forense</span>
          <h3 class="font-serif text-lg font-bold text-slate-950 dark:text-stone-100 group-hover:text-amber-700 dark:group-hover:text-amber-400 mt-1">
            La Sábana Santa: Rayos X WAXS y STURP &rarr;
          </h3>
          <p class="text-xs text-stone-500 dark:text-stone-400 mt-2 line-clamp-2">
            La datación por rayos X del siglo I, sangre humana AB torturada e imagen tridimensional sin pigmentos.
          </p>
        </a>

        <a
          href="/santos/faustina-kowalska/"
          class="p-5 rounded-2xl bg-white dark:bg-slate-950 border border-stone-200 dark:border-slate-800 hover:border-amber-500/50 transition-all group"
        >
          <span class="text-xs font-semibold text-rose-700 dark:text-rose-400 uppercase tracking-wide">Mística &middot; Vilna 1934</span>
          <h3 class="font-serif text-lg font-bold text-slate-950 dark:text-stone-100 group-hover:text-amber-700 dark:group-hover:text-amber-400 mt-1">
            Santa Faustina y la Divina Misericordia &rarr;
          </h3>
          <p class="text-xs text-stone-500 dark:text-stone-400 mt-2 line-clamp-2">
            El cuadro original de Kazimirowski, coincidencia biométrica 1:1 con la Síndone y la Coronilla.
          </p>
        </a>

        <a
          href="/ciencia-y-fe/virgen-de-guadalupe-tilma/"
          class="p-5 rounded-2xl bg-white dark:bg-slate-950 border border-stone-200 dark:border-slate-800 hover:border-amber-500/50 transition-all group"
        >
          <span class="text-xs font-semibold text-amber-700 dark:text-amber-400 uppercase tracking-wide">Aparición &middot; Óptica</span>
          <h3 class="font-serif text-lg font-bold text-slate-950 dark:text-stone-100 group-hover:text-amber-700 dark:group-hover:text-amber-400 mt-1">
            La Tilma de Guadalupe: El Secreto Ocular &rarr;
          </h3>
          <p class="text-xs text-stone-500 dark:text-stone-400 mt-2 line-clamp-2">
            490 años sin descomposición de agave, examen infrarrojo de la NASA y 13 figuras en la córnea.
          </p>
        </a>

        <a
          href="/milagros-eucaristicos/buenos-aires/"
          class="p-5 rounded-2xl bg-white dark:bg-slate-950 border border-stone-200 dark:border-slate-800 hover:border-amber-500/50 transition-all group"
        >
          <span class="text-xs font-semibold text-rose-700 dark:text-rose-400 uppercase tracking-wide">Milagro Eucarístico</span>
          <h3 class="font-serif text-lg font-bold text-slate-950 dark:text-stone-100 group-hover:text-amber-700 dark:group-hover:text-amber-400 mt-1">
            Buenos Aires 1996: Análisis Forense a Ciegas &rarr;
          </h3>
          <p class="text-xs text-stone-500 dark:text-stone-400 mt-2 line-clamp-2">
            El informe del Dr. Frederic Zugibe (Columbia): miocardio vivo en agonía y glóbulos blancos intactos.
          </p>
        </a>

        <a
          href="/ciencia-y-fe/lourdes-bureau-medical/"
          class="p-5 rounded-2xl bg-white dark:bg-slate-950 border border-stone-200 dark:border-slate-800 hover:border-amber-500/50 transition-all group"
        >
          <span class="text-xs font-semibold text-blue-700 dark:text-blue-400 uppercase tracking-wide">Comité Científico</span>
          <h3 class="font-serif text-lg font-bold text-slate-950 dark:text-stone-100 group-hover:text-amber-700 dark:group-hover:text-amber-400 mt-1">
            El Bureau Médical de Lourdes y los 7 Criterios &rarr;
          </h3>
          <p class="text-xs text-stone-500 dark:text-stone-400 mt-2 line-clamp-2">
            Regeneración ósea probada (Vittorio Micheli) e incorrupción de Santa Bernardita Soubirous.
          </p>
        </a>

        <a
          href="/milagros-eucaristicos/sokolka/"
          class="p-5 rounded-2xl bg-white dark:bg-slate-950 border border-stone-200 dark:border-slate-800 hover:border-amber-500/50 transition-all group"
        >
          <span class="text-xs font-semibold text-rose-700 dark:text-rose-400 uppercase tracking-wide">Milagro Eucarístico</span>
          <h3 class="font-serif text-lg font-bold text-slate-950 dark:text-stone-100 group-hover:text-amber-700 dark:group-hover:text-amber-400 mt-1">
            Sokółka 2008: Fusión Molecular de Pan y Corazón &rarr;
          </h3>
          <p class="text-xs text-stone-500 dark:text-stone-400 mt-2 line-clamp-2">
            Microscopía electrónica de la Universidad Médica de Białystok que refuta la bacteria Serratia.
          </p>
        </a>

        <a
          href="/virgen-de-fatima/milagro-del-sol/"
          class="p-5 rounded-2xl bg-white dark:bg-slate-950 border border-stone-200 dark:border-slate-800 hover:border-amber-500/50 transition-all group"
        >
          <span class="text-xs font-semibold text-blue-700 dark:text-blue-400 uppercase tracking-wide">Fátima 1917</span>
          <h3 class="font-serif text-lg font-bold text-slate-950 dark:text-stone-100 group-hover:text-amber-700 dark:group-hover:text-amber-400 mt-1">
            El Milagro del Sol y la Prensa Laica &rarr;
          </h3>
          <p class="text-xs text-stone-500 dark:text-stone-400 mt-2 line-clamp-2">
            La crónica secular de O Século ante más de 70.000 testigos presenciales.
          </p>
        </a>

        <a
          href="/rosario/"
          class="p-5 rounded-2xl bg-white dark:bg-slate-950 border border-stone-200 dark:border-slate-800 hover:border-amber-500/50 transition-all group"
        >
          <span class="text-xs font-semibold text-amber-600 dark:text-amber-400 uppercase tracking-wide">PWA &middot; Visualizador SVG</span>
          <h3 class="font-serif text-lg font-bold text-slate-950 dark:text-stone-100 group-hover:text-amber-700 dark:group-hover:text-amber-400 mt-1">
            Santo Rosario y Coronilla de la Misericordia &rarr;
          </h3>
          <p class="text-xs text-stone-500 dark:text-stone-400 mt-2 line-clamp-2">
            Rosario visual interactivo, audio chime armónico, selector de misterios y devociones añadidas.
          </p>
        </a>
      </div>
    </section>

    <!-- 3. Categorías Principales (Los Pilares del Proyecto) -->
    <section>
      <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-8 gap-4">
        <div>
          <span class="text-xs font-semibold uppercase tracking-wider text-amber-700 dark:text-amber-400">
            Categorías Principales
          </span>
          <h2 class="font-serif text-2xl sm:text-3xl font-bold text-slate-950 dark:text-stone-100 mt-1">
            Los Pilares de Razón y Asombro
          </h2>
        </div>
        <p class="text-sm text-stone-600 dark:text-stone-400 max-w-md">
          Cada sección articula la doctrina de la Iglesia con fuentes primarias rigurosas y una llamada viva a la conversión interior.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {pillars.map((p) => (
          <PillarCard
            title={p.title}
            description={p.description}
            href={p.href}
            badge={p.badge}
          />
        ))}
      </div>
    </section>

    <!-- 4. Recursos de Oración y Formación -->
    <section class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <!-- Buscador de Consuelo Espiritual -->
      <div class="p-6 sm:p-8 rounded-3xl bg-stone-100/80 dark:bg-slate-900/80 border border-stone-200 dark:border-slate-800 flex flex-col justify-between space-y-4">
        <div class="space-y-2">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-amber-600/10 text-amber-800 dark:text-amber-300 border border-amber-600/20">
            <span class="w-2 h-2 rounded-full bg-amber-600"></span>
            Refugio para el Alma Herida
          </span>
          <h3 class="font-serif text-xl sm:text-2xl font-bold text-slate-950 dark:text-stone-100">
            ¿Llevas una pena, angustia o duda en el corazón?
          </h3>
          <p class="text-xs sm:text-sm text-stone-600 dark:text-stone-300 leading-relaxed font-reading">
            Encuentra bálsamo en las promesas de la Sagrada Escritura, los consejos vivos de los Santos y una guía de oración concreta para este instante.
          </p>
        </div>
        <div>
          <a
            href="/consuelo/"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl font-semibold text-xs sm:text-sm text-white bg-amber-600 hover:bg-amber-700 transition-all shadow-sm"
          >
            <span>Buscar Consuelo Espiritual &rarr;</span>
          </a>
        </div>
      </div>

      <!-- Muro de Oración Comunitario -->
      <div class="p-6 sm:p-8 rounded-3xl bg-stone-100/80 dark:bg-slate-900/80 border border-stone-200 dark:border-slate-800 flex flex-col justify-between space-y-4">
        <div class="space-y-2">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-indigo-500/10 text-indigo-800 dark:text-indigo-300 border border-indigo-500/20">
            🕯️ Comunión de los Santos
          </span>
          <h3 class="font-serif text-xl sm:text-2xl font-bold text-slate-950 dark:text-stone-100">
            Muro de Oración e Intenciones
          </h3>
          <p class="text-xs sm:text-sm text-stone-600 dark:text-stone-300 leading-relaxed font-reading">
            Enciende una vela virtual y une tu súplica a las decenas del Santo Rosario ofrecidas diariamente por nuestra comunidad de fieles.
          </p>
        </div>
        <div>
          <a
            href="/oracion/"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl font-semibold text-xs sm:text-sm text-stone-800 dark:text-stone-200 bg-stone-200/80 dark:bg-slate-800 hover:bg-stone-300/80 dark:hover:bg-slate-700 transition-colors shadow-xs"
          >
            <span>Ir al Muro de Oración &rarr;</span>
          </a>
        </div>
      </div>
    </section>

    <!-- Módulo de Sostenimiento y Donaciones -->
    <section class="pt-4">
      <SupportCard variant="full" />
    </section>

  </div>
</BaseLayout>

