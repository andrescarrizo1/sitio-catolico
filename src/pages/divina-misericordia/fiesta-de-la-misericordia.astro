---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/global/Breadcrumbs.astro';
import FaqAccordion from '../../components/ui/FaqAccordion.astro';
import NextStep from '../../components/ui/NextStep.astro';
import { getGitCommitDate } from '../../utils/getGitDate';

const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : (import.meta.env.PUBLIC_SITE_URL || 'https://razonyasombro.com');
const currentURL = `${siteUrl}/divina-misericordia/fiesta-de-la-misericordia/`;

const alternateLinks = [
  { hreflang: 'es', href: currentURL },
  { hreflang: 'x-default', href: currentURL },
];

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": currentURL
  },
  "headline": "La Fiesta de la Divina Misericordia: Origen, Promesas e Indulgencias",
  "description": "Guía litúrgica sobre la Fiesta de la Divina Misericordia (segundo domingo de Pascua): promesas del Diario n. 699 e indulgencias plenarias de la Iglesia.",
  "image": [`${siteUrl}/images/jesus-misericordioso-kazimirowski.jpg`],
  "url": currentURL,
  "datePublished": "2026-11-16T00:00:00Z",
  "dateModified": getGitCommitDate('src/pages/divina-misericordia/fiesta-de-la-misericordia.astro', '2026-11-16T00:00:00Z'),
  "author": [
    {
      "@type": "Organization",
      "name": "Razón y Asombro",
      "url": `${siteUrl}/autor/`
    }
  ],
  "publisher": {
    "@type": "Organization",
    "name": "Razón y Asombro",
    "url": `${siteUrl}/`,
    "logo": {
      "@type": "ImageObject",
      "url": `${siteUrl}/favicon.svg`
    }
  }
};

const faqItems = [
  {
    question: "¿Cuándo se celebra la Fiesta de la Divina Misericordia?",
    answer: "Se celebra el Segundo Domingo de Pascua (antiguamente conocido como Domingo in Albis o Domingo de Santo Tomás). Fue instituida formalmente para toda la Iglesia Católica universal por el Papa San Juan Pablo II el 30 de abril del año 2000, durante la canonización de Santa Faustina Kowalska."
  },
  {
    question: "¿Cuál es la gracia extraordinaria prometida por Jesús en esta fiesta?",
    answer: "En el Diario de Santa Faustina (n. 699), Jesucristo prometió: «El alma que se confiese y reciba la Santa Comunión obtendrá el perdón total de las culpas y de las penas. En ese día están abiertas todas las compuertas divinas a través de las cuales fluyen las gracias». Los teólogos la comparan analógicamente con la gracia bautismal de renovación interior total."
  },
  {
    question: "¿Es necesario confesarse exactamente el mismo domingo de la fiesta?",
    answer: "No necesariamente. La Iglesia enseña que la confesión sacramental puede realizarse con anterioridad (por ejemplo, durante la Cuaresma o Semana Santa), siempre que al momento de comulgar en el Domingo de la Misericordia el alma se encuentre en estado de gracia (sin pecado mortal sin confesar) y mantenga el espíritu de penitencia y confianza."
  },
  {
    question: "¿Cómo se obtiene la Indulgencia Plenaria concedida por la Santa Sede?",
    answer: "Conforme al Decreto de la Penitenciaría Apostólica del 29 de junio de 2002, se concede Indulgencia Plenaria a los fieles que, en el Segundo Domingo de Pascua, con desapego total a cualquier pecado (incluso venial), cumplan las tres condiciones habituales (Confesión sacramental, Comunión eucarística y oración por las intenciones del Papa) y en cualquier iglesia o capilla recen el Padrenuestro, el Credo y una invocación piadosa al Señor Jesús misericordioso (por ejemplo, «Jesús misericordioso, en Ti confío»)."
  }
];
---

<BaseLayout
  title="Fiesta de la Divina Misericordia | Razón y Asombro"
  description="Guía litúrgica sobre la Fiesta de la Divina Misericordia (segundo domingo de Pascua): promesas del Diario n. 699 e indulgencias plenarias de la Iglesia."
  image="/images/jesus-misericordioso-kazimirowski.jpg"
  alternateLinks={alternateLinks}
>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 space-y-8">
    <Breadcrumbs
      crumbs={[
        { label: 'Inicio', href: '/' },
        { label: 'Divina Misericordia', href: '/divina-misericordia/' },
        { label: 'Fiesta de la Misericordia' }
      ]}
    />

    <!-- Header Principal -->
    <header class="space-y-4 border-b border-stone-200 dark:border-slate-800 pb-8">
      <div class="flex flex-wrap items-center gap-2">
        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-red-500/10 text-red-800 dark:text-red-300 border border-red-500/20">
          Segundo Domingo de Pascua &middot; Solemnidad Litúrgica
        </span>
        <span class="text-xs font-mono text-stone-500 dark:text-stone-400">
          Institución: San Juan Pablo II (AAS 92, 2000)
        </span>
      </div>

      <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-slate-950 dark:text-stone-100 leading-[1.2]">
        La Fiesta de la Divina Misericordia: Gracia Plena del Resucitado
      </h1>

      <p class="text-base sm:text-lg text-stone-700 dark:text-stone-300 font-reading leading-relaxed">
        El Segundo Domingo de Pascua culmina la Octava de la Resurrección con una efusión sobreabundante de gracia salvífica. Conoce la historia de su institución eclesial por San Juan Pablo II, las promesas registradas en el Diario de Santa Faustina y los requisitos de la Santa Sede para recibir la Indulgencia Plenaria.
      </p>

      <!-- Barra de Navegación del Cluster -->
      <div class="pt-2 flex flex-wrap gap-2 text-xs">
        <a href="/divina-misericordia/" class="px-3 py-1.5 rounded-lg bg-stone-100 dark:bg-slate-800 text-stone-700 dark:text-stone-300 hover:bg-stone-200 dark:hover:bg-slate-700 transition-colors">
          &larr; Volver al Pilar
        </a>
        <span class="px-3 py-1.5 rounded-lg bg-red-500/20 text-red-900 dark:text-red-200 font-bold border border-red-500/30">
          La Fiesta e Indulgencias
        </span>
        <a href="/rosario/coronilla-divina-misericordia/" class="px-3 py-1.5 rounded-lg bg-stone-100 dark:bg-slate-800 text-stone-700 dark:text-stone-300 hover:bg-stone-200 dark:hover:bg-slate-700 transition-colors">
          Rezar la Coronilla &rarr;
        </a>
        <a href="/divina-misericordia/hora-de-la-misericordia/" class="px-3 py-1.5 rounded-lg bg-stone-100 dark:bg-slate-800 text-stone-700 dark:text-stone-300 hover:bg-stone-200 dark:hover:bg-slate-700 transition-colors">
          La Hora de las 15:00 &rarr;
        </a>
      </div>
    </header>

    <!-- Contenido Editorial -->
    <article class="space-y-10 text-stone-800 dark:text-stone-200 font-reading leading-relaxed">

      <!-- Sección 1: El Sentido Litúrgico y Bíblico -->
      <section class="space-y-4">
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-slate-950 dark:text-stone-100">
          1. El Segundo Domingo de Pascua: El Día del Perdón
        </h2>
        <p>
          Lejos de ser una fecha caprichosa, el Segundo Domingo de Pascua encierra una profunda coherencia litúrgica. En la Misa de ese día, el Evangelio proclama siempre el pasaje de San Juan (Jn 20, 19-31) en el que Cristo resucitado se aparece a los apóstoles en el Cenáculo, sopla sobre ellos y les confiere el poder de perdonar los pecados en el Espíritu Santo:
        </p>
        <blockquote class="p-4 rounded-xl bg-stone-50 dark:bg-slate-800/60 border-l-4 border-red-500 text-sm sm:text-base italic text-stone-800 dark:text-stone-200">
          «Recibid el Espíritu Santo: a quienes perdonareis los pecados, les quedan perdonados; y a quienes se los retuviereis, les quedan retenidos.»
          <footer class="mt-2 text-xs not-italic font-mono text-stone-500">— San Juan 20, 22-23 (Vulgata Torres Amat 1825)</footer>
        </blockquote>
        <p>
          Es precisamente el domingo en que Jesús instituye formalmente el sacramento de la Penitencia y muestra sus llagas gloriosas al apóstol Tomás, disipando sus dudas y revelándose como «Señor mío y Dios mío».
        </p>
      </section>

      <!-- Sección 2: La Institución Universal por San Juan Pablo II -->
      <section class="space-y-4">
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-slate-950 dark:text-stone-100">
          2. La Institución Universal por San Juan Pablo II (Año 2000)
        </h2>
        <p>
          El 30 de abril del año jubilar 2000, durante la solemne ceremonia de canonización de Santa Faustina Kowalska en la Plaza de San Pedro, el Papa San Juan Pablo II cumplió el deseo transmitido por Jesús en las apariciones de Polonia:
        </p>
        <blockquote class="p-5 rounded-xl bg-white dark:bg-slate-900 border-l-4 border-red-600 dark:border-red-500 shadow-xs text-sm sm:text-base italic text-stone-800 dark:text-stone-200 space-y-2">
          <p>
            «Es importante que acojamos íntegramente el mensaje que nos transmite la palabra de Dios en este segundo domingo de Pascua, que a partir de ahora en toda la Iglesia se llamará "Domingo de la Divina Misericordia". En los diversos pasajes de la liturgia parece trazarse el diseño de la misericordia, que reconstruye la relación entre el hombre y Dios.»
          </p>
          <footer class="text-xs not-italic font-mono text-stone-500">— San Juan Pablo II, Homilía de Canonización (30 de abril de 2000)</footer>
        </blockquote>
        <p>
          Cinco días después, el 5 de mayo de 2000, la Congregación para el Culto Divino y la Disciplina de los Sacramentos publicó el decreto oficial por el cual se insertaba dicha denominación en el Calendario Romano General.
        </p>
      </section>

      <!-- Sección 3: Las Promesas del Diario (n. 699) -->
      <section class="space-y-4">
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-slate-950 dark:text-stone-100">
          3. La Promesa Extraordinaria del Diario (n. 699)
        </h2>
        <p>
          Entre todas las gracias confiadas por Jesús a Santa Faustina, la vinculada a la Fiesta de la Misericordia es la más deslumbrante en magnitud:
        </p>
        <blockquote class="p-5 rounded-xl bg-white dark:bg-slate-900 border-l-4 border-red-600 dark:border-red-500 shadow-xs text-sm sm:text-base italic text-stone-800 dark:text-stone-200 space-y-2">
          <p>
            «Deseo que la Fiesta de la Misericordia sea refugio y amparo para todas las almas y, especialmente, para los pobres pecadores. Ese día están abiertas las entrañas de mi misericordia. Derramo todo un mar de gracias sobre las almas que se acercan al manantial de mi misericordia. El alma que se confiese y reciba la Santa Comunión obtendrá el perdón total de las culpas y de las penas. En ese día están abiertas todas las compuertas divinas a través de las cuales fluyen las gracias.»
          </p>
          <footer class="text-xs not-italic font-mono text-stone-500">— Diario de Santa Faustina, n. 699</footer>
        </blockquote>
        <p>
          El teólogo Ignacio Różycki subrayó en sus estudios canónicos que esta promesa encierra un valor espiritual análogo al del Santo Bautismo: quien se confiese y comulgue dignamente con pureza de intención recibe la remisión no sólo de la culpa de los pecados perdonados, sino de toda la pena temporal merecida por ellos en el Purgatorio.
        </p>
      </section>

      <!-- Sección 4: El Decreto de Indulgencia Plenaria de la Santa Sede -->
      <section class="space-y-4">
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-slate-950 dark:text-stone-100">
          4. La Indulgencia Plenaria de la Santa Sede (Decreto del 2002)
        </h2>
        <p>
          Para enriquecer con la autoridad de las llaves de la Iglesia el tesoro espiritual de esta festividad, la Penitenciaría Apostólica promulgó el 29 de junio de 2002 un Decreto formal concediendo la <strong>Indulgencia Plenaria</strong> a los fieles que cumplan los siguientes preceptos en el Domingo de la Divina Misericordia:
        </p>

        <div class="p-6 rounded-2xl bg-stone-100/70 dark:bg-slate-900/70 border border-stone-200 dark:border-slate-800 space-y-3">
          <h3 class="font-serif text-lg font-bold text-slate-900 dark:text-stone-100 m-0">Condiciones Eclesiales Canónicas:</h3>
          <ol class="space-y-2 list-decimal pl-5 text-sm sm:text-base text-stone-700 dark:text-stone-300">
            <li><strong>Disposición del alma:</strong> Desapego total de cualquier afecto al pecado, incluso al pecado venial.</li>
            <li><strong>Los Tres Sacramentos/Oraciones habituales:</strong> Confesión sacramental (puede realizarse días antes o después), Comunión eucarística en el día de la fiesta y oración por las intenciones del Santo Padre (un Padre Nuestro y un Ave María).</li>
            <li><strong>El Acto Devocional propio:</strong> En cualquier iglesia o capilla abierta al culto, participar devotamente en las prácticas de piedad en honor de la Divina Misericordia, o bien rezar ante el Santísimo Sacramento (expuesto o reservado en el Sagrario) el Padre Nuestro, el Credo y una jaculatoria al Señor Jesús misericordioso (por ejemplo: «Jesús misericordioso, en Ti confío»).</li>
          </ol>
        </div>
      </section>

      <!-- Sección 5: La Novena de la Divina Misericordia -->
      <section class="space-y-4">
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-slate-950 dark:text-stone-100">
          5. La Novena Preparatoria (Inicia el Viernes Santo)
        </h2>
        <p>
          Como preparación interior para la gran solemnidad, Jesús pidió a Santa Faustina iniciar una novena de nueve días a partir del Viernes Santo (Diario, n. 1209). Cada día de la novena se encomienda a un grupo específico de almas al Corazón de Jesús:
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 text-xs">
          <div class="p-3 rounded-lg bg-white dark:bg-slate-900 border border-stone-200 dark:border-slate-800">
            <strong>Día 1:</strong> Toda la humanidad y pecadores.
          </div>
          <div class="p-3 rounded-lg bg-white dark:bg-slate-900 border border-stone-200 dark:border-slate-800">
            <strong>Día 2:</strong> Sacerdotes y religiosos.
          </div>
          <div class="p-3 rounded-lg bg-white dark:bg-slate-900 border border-stone-200 dark:border-slate-800">
            <strong>Día 3:</strong> Almas devotas y fieles.
          </div>
          <div class="p-3 rounded-lg bg-white dark:bg-slate-900 border border-stone-200 dark:border-slate-800">
            <strong>Día 4:</strong> Quienes no conocen a Cristo.
          </div>
          <div class="p-3 rounded-lg bg-white dark:bg-slate-900 border border-stone-200 dark:border-slate-800">
            <strong>Día 5:</strong> Separados de la unidad de la Iglesia.
          </div>
          <div class="p-3 rounded-lg bg-white dark:bg-slate-900 border border-stone-200 dark:border-slate-800">
            <strong>Día 6:</strong> Almas mansas, humildes y niños.
          </div>
          <div class="p-3 rounded-lg bg-white dark:bg-slate-900 border border-stone-200 dark:border-slate-800">
            <strong>Día 7:</strong> Almas que veneran la Misericordia.
          </div>
          <div class="p-3 rounded-lg bg-white dark:bg-slate-900 border border-stone-200 dark:border-slate-800">
            <strong>Día 8:</strong> Almas del Purgatorio.
          </div>
          <div class="p-3 rounded-lg bg-white dark:bg-slate-900 border border-stone-200 dark:border-slate-800">
            <strong>Día 9:</strong> Almas tibias y desalentadas.
          </div>
        </div>
      </section>

    </article>

    <!-- Preguntas Frecuentes Reutilizables -->
    <FaqAccordion
      title="Preguntas Frecuentes sobre la Fiesta de la Misericordia"
      subtitle="Respuestas basadas en el Magisterio de la Iglesia y las disposiciones de la Santa Sede."
      items={faqItems}
    />

    <!-- Siguiente paso pastoral -->
    <NextStep
      variant="jesus"
      customTitle="Comienza el Rezo de la Coronilla"
      customAction="Acompaña la devoción de esta fiesta rezando la Coronilla cuenta por cuenta en nuestro visor interactivo libre de distracciones."
    />

    <!-- Fuentes y Metadatos de Revisión -->
    <footer class="mt-12 pt-6 border-t border-stone-200 dark:border-slate-800 text-xs text-stone-500 dark:text-stone-400 space-y-2">
      <p>
        <strong>Fuentes Principales:</strong> Santa María Faustina Kowalska, <em>La Divina Misericordia en mi alma: Diario</em> (Edición Crítica, nn. 300, 699, 1209); San Juan Pablo II, Homilía de Canonización de Santa Faustina (AAS 92, 2000); Congregación para el Culto Divino, Decreto <em>Misericordia Divina</em> (5 de mayo de 2000); Penitenciaría Apostólica, Decreto sobre las Indulgencias en el Domingo de la Divina Misericordia (29 de junio de 2002).
      </p>
      <p>
        <strong>Equipo Editorial:</strong> Razón y Asombro &middot; Revisión Canónica y Bíblica Interna &middot; Última actualización: Noviembre de 2026.
      </p>
    </footer>

  </div>
</BaseLayout>
