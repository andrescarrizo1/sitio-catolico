---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/global/Breadcrumbs.astro';
import FaqAccordion from '../../components/ui/FaqAccordion.astro';
import NextStep from '../../components/ui/NextStep.astro';
import { getGitCommitDate } from '../../utils/getGitDate';

const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : (import.meta.env.PUBLIC_SITE_URL || 'https://razonyasombro.com');
const currentURL = `${siteUrl}/biblia/el-misterio-del-sufrimiento-en-la-biblia/`;

const alternateLinks = [
  { hreflang: 'es', href: currentURL },
  { hreflang: 'x-default', href: currentURL },
];

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": currentURL
  },
  "headline": "El Misterio del Sufrimiento en la Biblia: De Job y la Cruz a Salvifici Doloris",
  "description": "Exégesis católica del misterio del dolor: la prueba del libro de Job, la teología de la Cruz y la carta Salvifici Doloris de San Juan Pablo II.",
  "image": [`${siteUrl}/og-default.jpg`],
  "url": currentURL,
  "datePublished": "2026-05-20T00:00:00Z",
  "dateModified": getGitCommitDate('src/pages/biblia/el-misterio-del-sufrimiento-en-la-biblia.astro'),
  "author": [
    {
      "@type": "Organization",
      "name": "Razón y Asombro",
      "url": `${siteUrl}/autor/`
    }
  ],
  "publisher": {
    "@type": "Organization",
    "name": "Razón y Asombro",
    "url": `${siteUrl}/`,
    "logo": {
      "@type": "ImageObject",
      "url": `${siteUrl}/favicon.svg`
    }
  }
};

const faqItems = [
  {
    question: "¿Por qué permite Dios que sufran las personas justas e inocentes?",
    answer: "El misterio del dolor inocente encuentra en la revelación bíblica una respuesta progresiva. El libro de Job refuta definitivamente la idea de que todo dolor es un castigo por pecados individuales. En Cristo crucificado, Dios no ofrece una explicación teórica abstracta, sino que desciende a padecer con el inocente, revelando que el sufrimiento puede convertirse en el instrumento de redención más fecundo y en testimonio de amor oblativo."
  },
  {
    question: "¿Qué error refutan el libro de Job y las palabras de Jesús sobre la enfermedad?",
    answer: "Refutan la llamada 'teología de la retribución mecánica', común en el antiguo Oriente, según la cual la prosperidad terrena era prueba indiscutible de santidad y la tragedia o enfermedad grave constituía un castigo divino forzoso. En el Evangelio de San Juan (Jn 9, 1-3), ante el ciego de nacimiento, Jesús niega categóricamente que su ceguera sea culpa de sus pecados o de los de sus padres: «Ni este pecó, ni sus padres; sino para que las obras de Dios se manifiesten en él»."
  },
  {
    question: "¿Qué significa en la doctrina católica «ofrecer el sufrimiento»?",
    answer: "Significa unir conscientemente el dolor físico, moral o espiritual inevitable de cada día a los padecimientos de Cristo en la Cruz (Colosenses 1, 24). Lejos de ser resignación pasiva, es un acto sacerdotal del bautizado que transforma el dolor estéril en intercesión ardiente por la conversión de pecadores, la paz y la purificación de la Iglesia."
  },
  {
    question: "¿Cuál es la tesis central de Salvifici Doloris de San Juan Pablo II?",
    answer: "San Juan Pablo II enseña que en la Cruz de Cristo el sufrimiento humano ha sido 'redimido y transfigurado'. Al asumir libremente el dolor hasta el extremo por puro amor, Cristo venció al mal desde sus raíces ontológicas y abrió el sufrimiento a una dimensión sobrenatural: hacer al hombre capaz de amar como Dios ama y desatar en el mundo una sobreabundancia de bien."
  }
];
---

<BaseLayout
  title="El Misterio del Sufrimiento en la Biblia: De Job y la Cruz a Salvifici Doloris | Razón y Asombro"
  description="Exégesis católica del misterio del dolor: la prueba del libro de Job, la teología de la Cruz y la carta Salvifici Doloris de San Juan Pablo II."
  alternateLinks={alternateLinks}
>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 space-y-8">
    <Breadcrumbs
      crumbs={[
        { label: 'Biblia y Conversión', href: '/biblia/' },
        { label: 'El Misterio del Sufrimiento' }
      ]}
    />

    <!-- Header Principal -->
    <header class="space-y-4 border-b border-stone-200 dark:border-slate-800 pb-8">
      <div class="flex flex-wrap items-center gap-2">
        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-amber-500/10 text-amber-800 dark:text-amber-300 border border-amber-500/20">
          Exégesis Bíblica &middot; Teología del Sufrimiento
        </span>
        <span class="text-xs font-mono text-stone-500 dark:text-stone-400">
          Magisterio: Salvifici Doloris (San Juan Pablo II)
        </span>
      </div>

      <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-slate-950 dark:text-stone-100 leading-[1.2]">
        El Misterio del Sufrimiento en la Biblia: De Job y la Cruz a *Salvifici Doloris*
      </h1>

      <p class="text-base sm:text-lg text-stone-700 dark:text-stone-300 font-reading leading-relaxed">
        El dolor humano es la pregunta más punzante que la existencia dirige al Creador. Frente a las respuestas superficiales que confunden el sufrimiento con un castigo ciego o con un absurdo biológico, la revelación bíblica despliega un itinerario que culmina en la Cruz de Jesucristo.
      </p>

      <!-- Caja de Clasificación Epistémica -->
      <div class="p-4 rounded-xl bg-stone-100/70 dark:bg-slate-900/70 border border-stone-200 dark:border-slate-800 text-xs sm:text-sm text-stone-600 dark:text-stone-400 space-y-1">
        <p><strong>Certeza Epistémica:</strong> Los textos de Job, Isaías y el Nuevo Testamento constituyen <em>Sagrada Escritura divinamente inspirada</em>. La encíclica <em>Salvifici Doloris</em> representa una <em>enseñanza autorizada del Magisterio de la Iglesia</em> que ilumina pastoralmente el misterio de la redención.</p>
        <p><strong>Fuentes Textuales:</strong> Citas tomadas de la <em>Vulgata latina</em> traducida por el Ilmo. D. Félix Torres Amat (Madrid, 1825, Dominio Público).</p>
      </div>
    </header>

    <!-- Cuerpo del Estudio -->
    <article class="prose prose-stone dark:prose-invert max-w-none space-y-8 text-stone-800 dark:text-stone-200 font-reading text-base sm:text-lg leading-relaxed">
      
      <!-- Sección 1: El Libro de Job -->
      <section class="space-y-4">
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-slate-950 dark:text-stone-100 border-b border-stone-200 dark:border-slate-800 pb-2">
          1. El drama de Job: La ruptura de la retribución mecánica
        </h2>
        <p>
          En el Antiguo Oriente prevalecía una doctrina simplista y cruel: si un hombre padecía lepra, ceguera, ruina económica o la muerte prematura de sus hijos, se daba por sentado que ocultaba un pecado abominable. Era la denominada <em>teología de la retribución terrestre</em>.
        </p>
        <p>
          El libro sagrado de <strong>Job</strong> desintegra para siempre esa falsa seguridad moral. Job es presentado explícitamente por el autor sagrado como un hombre «íntegro, recto, temeroso de Dios y apartado del mal» (Job 1, 1). Sin embargo, pierde en un solo día sus ganados, sus siervos, sus diez hijos y finalmente su salud física, cubierto de úlceras malignas desde la planta del pie hasta la coronilla.
        </p>
        <blockquote class="p-4 rounded-xl bg-stone-100 dark:bg-slate-800/60 border-l-4 border-amber-600 not-italic text-sm sm:text-base text-stone-900 dark:text-stone-100">
          «Desnudo salí del vientre de mi madre, y desnudo tornaré allá. El Señor lo dio, y el Señor lo quitó; bendito sea el nombre del Señor.»
          <footer class="mt-2 text-xs font-mono text-stone-500 dark:text-stone-400">— Job 1, 21 (Torres Amat 1825)</footer>
        </blockquote>
        <p>
          Cuando sus tres amigos (Elifaz, Bildad y Zofar) llegan con discursos teológicos rígidos para forzarlo a confesar crímenes imaginarios, Job se niega con vehemencia a aceptar la mentira. Su protesta no es blasfemia, sino fidelidad desgarrada: Job increpa a Dios porque confía en que Dios es infinitamente más justo y veraz que los teólogos de salón.
        </p>
        <p>
          Al final del libro, cuando Dios habla desde el torbellino, no explica el porqué del sufrimiento ni formula un silogismo filosófico. Le revela en cambio la sobreabundante sabiduría de la Creación, trascendiendo las estrechas categorías humanas: <em>«Yo te conocía sólo de oídas; mas ahora mis ojos te ven. Por tanto, me retracto y me arrepiento en el polvo y en la ceniza»</em> (Job 42, 5-6).
        </p>
      </section>

      <!-- Sección 2: Isaías y el Siervo Doliente -->
      <section class="space-y-4">
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-slate-950 dark:text-stone-100 border-b border-stone-200 dark:border-slate-800 pb-2">
          2. Isaías y el dolor vicario: Las heridas que curan
        </h2>
        <p>
          Si en Job el dolor inocente es un misterio de confianza pura, en el profeta Isaías el sufrimiento alcanza un nuevo umbral: el **sufrimiento vicario**, aquel que se padece libremente en favor y en lugar de otros.
        </p>
        <p>
          En el cuarto Cántico del Siervo de Yahvé (Isaías 52, 13 – 53, 12), escrito siete siglos antes de Cristo, encontramos la profecía más conmovedora de la Pasión:
        </p>
        <blockquote class="p-4 rounded-xl bg-stone-100 dark:bg-slate-800/60 border-l-4 border-amber-600 not-italic text-sm sm:text-base text-stone-900 dark:text-stone-100">
          «Despreciado y el más vil de los hombres, varón de dolores y experimentado en quebrantos... Ciertamente él llevó nuestras enfermedades, y cargó con nuestros dolores; mas nosotros le tuvimos por azotado, herido de Dios y humillado. Pero él fue herido por nuestras iniquidades, molido por nuestros pecados; el castigo que nos procura la paz cayó sobre él, y por sus llagas fuimos nosotros curados.»
          <footer class="mt-2 text-xs font-mono text-stone-500 dark:text-stone-400">— Isaías 53, 3-5 (Torres Amat 1825)</footer>
        </blockquote>
        <p>
          El sufrimiento deja de ser un callejón sin salida punitivo. Puede asumir un valor expiatorio, liberador y purificador para una multitud que no merecía la salvación por sus propias fuerzas.
        </p>
      </section>

      <!-- Sección 3: Cristo en la Cruz -->
      <section class="space-y-4">
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-slate-950 dark:text-stone-100 border-b border-stone-200 dark:border-slate-800 pb-2">
          3. La Cruz de Cristo: Dios padece con el hombre
        </h2>
        <p>
          La respuesta definitiva del cristianismo al problema del mal no es una fórmula de teodicea abstracta, sino un **Acontecimiento histórico**: la Encarnación y la Crucifixión del Hijo unigénito de Dios.
        </p>
        <p>
          Dios no contempló el sufrimiento humano desde un trono de impasibilidad cósmica. Se hizo vulnerable, tomó carne humana, lloró ante la tumba de Lázaro, sudó sangre en Getsemaní y experimentó el límite extremo del dolor físico y del abandono afectivo en el Calvario.
        </p>
        <blockquote class="p-4 rounded-xl bg-stone-100 dark:bg-slate-800/60 border-l-4 border-amber-600 not-italic text-sm sm:text-base text-stone-900 dark:text-stone-100">
          «Porque tanto amó Dios al mundo, que le dio a su unigénito Hijo, para que todo el que cree en él no perezca, sino que tenga vida eterna.»
          <footer class="mt-2 text-xs font-mono text-stone-500 dark:text-stone-400">— San Juan 3, 16 (Torres Amat 1825)</footer>
        </blockquote>
        <p>
          Desde aquel Viernes Santo, ningún ser humano que gime en un hospital, en la soledad o bajo la injusticia puede decir que Dios es indiferente. En el lecho del sufrimiento humano está crucificado el propio Dios, convirtiendo el dolor en el lugar teológico del encuentro y la redención.
        </p>
      </section>

      <!-- Sección 4: Colosenses 1, 24 y San Pablo -->
      <section class="space-y-4">
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-slate-950 dark:text-stone-100 border-b border-stone-200 dark:border-slate-800 pb-2">
          4. La paradoja de San Pablo: Participantes en la Redención
        </h2>
        <p>
          En la epístola a los Colosenses, el apóstol San Pablo formula una de las sentencias más desconcertantes y profundas de todo el Nuevo Testamento:
        </p>
        <blockquote class="p-4 rounded-xl bg-stone-100 dark:bg-slate-800/60 border-l-4 border-amber-600 not-italic text-sm sm:text-base text-stone-900 dark:text-stone-100">
          «Ahora me alegro de mis padecimientos por vosotros, y cumplo en mi carne lo que falta de las aflicciones de Cristo por su cuerpo, que es la Iglesia.»
          <footer class="mt-2 text-xs font-mono text-stone-500 dark:text-stone-400">— Colosenses 1, 24 (Torres Amat 1825)</footer>
        </blockquote>
        <p>
          ¿Acaso el sacrificio de Cristo fue incompleto o insuficiente? La teología católica responde con firmeza: la redención de Cristo es infinita, perfecta y plenaria. Nada le falta en cuanto a su valor intrínseco.
        </p>
        <p>
          Lo que «falta» es **nuestra libre participación y asimilación en el Cuerpo Místico**. Cristo quiso que sus miembros estuvieran íntimamente asociados a su obra redentora. Quien sufre en comunión con Jesús no padece en vano: colabora activamente en la distribución de la gracia divina en el mundo.
        </p>
      </section>

      <!-- Sección 5: Salvifici Doloris de San Juan Pablo II -->
      <section class="space-y-4">
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-slate-950 dark:text-stone-100 border-b border-stone-200 dark:border-slate-800 pb-2">
          5. La síntesis de *Salvifici Doloris* (1984)
        </h2>
        <p>
          El 11 de febrero de 1984, tras recuperarse del atentado en la Plaza de San Pedro, el Papa San Juan Pablo II publicó su carta apostólica <em>Salvifici Doloris</em> («Sobre el sentido cristiano del sufrimiento humano»), considerada la obra cumbre del Magisterio contemporáneo sobre la materia.
        </p>
        <p>
          En ella, el Pontífice expone tres dimensiones cardinales:
        </p>
        <ol class="list-decimal pl-6 space-y-2">
          <li><strong>El sufrimiento desata el amor:</strong> El buen samaritano no pasa de largo ante el herido. El dolor en el mundo existe también para despertar la compasión, la caridad desinteresada y la entrega del prójimo.</li>
          <li><strong>El sufrimiento humaniza y purifica:</strong> Quien ha sufrido comprende con hondura el misterio del prójimo; el orgullo se quiebra y el corazón se vuelve permeable a la gracia.</li>
          <li><strong>El sufrimiento vence al mal:</strong> Al no responder a la violencia con odio, sino con oblación y perdón, el sufrimiento en Cristo detiene la espiral del pecado y transforma la historia desde adentro.</li>
        </ol>
      </section>

    </article>

    <!-- Sección de Preguntas Frecuentes con Componente Reutilizable -->
    <!-- Sección de Preguntas Frecuentes con Componente Reutilizable -->
    <FaqAccordion
      title="Preguntas Frecuentes sobre el Sufrimiento y la Fe"
      subtitle="Respuestas teológicas, bíblicas y canónicas a las dudas más comunes sobre el dolor."
      items={faqItems}
    />

    <!-- Enlaces Internos y Siguiente Paso -->
    <NextStep
      variant="biblia"
      customTitle="Continúa tu Itinerario Bíblico y de Oración"
      customAction="Descubre los versículos bíblicos de consuelo en momentos difíciles meditándolos en silencio o adéntrate en la contemplación de la Pasión en los Misterios Dolorosos del Rosario."
    />

    <!-- Fuentes y Metadatos de Revisión -->
    <footer class="mt-12 pt-6 border-t border-stone-200 dark:border-slate-800 text-xs text-stone-500 dark:text-stone-400 space-y-2">
      <p>
        <strong>Fuentes Principales:</strong> San Juan Pablo II, Carta Apostólica <em>Salvifici Doloris</em> (11 de febrero de 1984); Santo Tomás de Aquino, <em>Summa Theologiae</em> (III, q. 46-49); Sagrada Biblia Vulgata Latina, trad. Félix Torres Amat (Madrid: Imprenta de D. Miguel de Burgos, 1825, Dominio Público).
      </p>
      <p>
        <strong>Equipo Editorial:</strong> Razón y Asombro &middot; Revisión Bíblica y Teológica Interna &middot; Última actualización: Octubre de 2026.
      </p>
    </footer>

  </div>
</BaseLayout>
