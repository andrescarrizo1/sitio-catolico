---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/ui/Hero.astro';
import PillarCard from '../../components/ui/PillarCard.astro';
import Breadcrumbs from '../../components/global/Breadcrumbs.astro';

const bibliaList = await getCollection('biblia');
---

<BaseLayout
  title="Biblia y Conversión: Versículos por Temas Espirituales | Razón y Asombro"
  description="Versículos bíblicos católicos comentados por temas: esperanza ante el sufrimiento, perdón y fe en la traducción tradicional Torres Amat de dominio público."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <Breadcrumbs crumbs={[{ label: 'Biblia y Conversión' }]} />
  </div>

  <Hero
    badge="Sagrada Escritura &middot; Tradición &middot; Meditación"
    title="La Palabra Viva de Dios para la Conversión"
    subtitle="Pasajes bíblicos íntegros con contexto espiritual, reflexión pastoral profunda y examen de conciencia para transformar la vida cotidiana."
  />

  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-4 pb-8">
    <div class="p-6 sm:p-8 rounded-2xl bg-stone-100/70 dark:bg-slate-900/70 border border-stone-200 dark:border-slate-800 space-y-4 text-stone-700 dark:text-stone-300 text-sm sm:text-base leading-relaxed">
      <h2 class="font-serif text-xl sm:text-2xl font-bold text-slate-950 dark:text-stone-100">
        La Sagrada Escritura en la Vida de la Iglesia: Lectio Divina
      </h2>
      <p>
        Para la fe católica, la Biblia no es un mero documento arqueológico del pasado, sino la Palabra inspirada por el Espíritu Santo que sigue interpelando con eficacia viva el alma del creyente. San Jerónimo nos recuerda que <em>«ignorar las Escrituras es ignorar a Cristo»</em>. Por ello, cada itinerario de esta sección combina el texto fiel de la Vulgata latina (traducido por el Ilmo. Sr. D. Félix Torres Amat en 1825, de dominio público) con una lectura orante guiada.
      </p>
      <div class="grid grid-cols-1 md:grid-cols-4 gap-4 pt-2">
        <div class="p-3.5 rounded-xl bg-white dark:bg-slate-800/80 border border-stone-200/80 dark:border-slate-700 space-y-1">
          <span class="text-xs font-bold uppercase tracking-wider text-amber-700 dark:text-amber-400">1. Lectio (Lectura)</span>
          <p class="text-xs text-stone-600 dark:text-stone-400">¿Qué dice el texto bíblico en su verdad objetiva y en el designio salvífico de Dios?</p>
        </div>
        <div class="p-3.5 rounded-xl bg-white dark:bg-slate-800/80 border border-stone-200/80 dark:border-slate-700 space-y-1">
          <span class="text-xs font-bold uppercase tracking-wider text-amber-700 dark:text-amber-400">2. Meditatio (Meditación)</span>
          <p class="text-xs text-stone-600 dark:text-stone-400">¿Qué me dice este pasaje a mi vida, a mis heridas y a mis circunstancias actuales?</p>
        </div>
        <div class="p-3.5 rounded-xl bg-white dark:bg-slate-800/80 border border-stone-200/80 dark:border-slate-700 space-y-1">
          <span class="text-xs font-bold uppercase tracking-wider text-amber-700 dark:text-amber-400">3. Oratio (Oración)</span>
          <p class="text-xs text-stone-600 dark:text-stone-400">¿Qué respondo al Señor en alabanza, petición de perdón o súplica filial?</p>
        </div>
        <div class="p-3.5 rounded-xl bg-white dark:bg-slate-800/80 border border-stone-200/80 dark:border-slate-700 space-y-1">
          <span class="text-xs font-bold uppercase tracking-wider text-amber-700 dark:text-amber-400">4. Actio (Acción)</span>
          <p class="text-xs text-stone-600 dark:text-stone-400">¿Qué conversión concreta de conducta y obras de caridad brota de este encuentro?</p>
        </div>
      </div>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-10">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {bibliaList.map((b) => (
        <PillarCard
          title={b.data.tema_titulo}
          description={b.data.descripcion_pastoral}
          href={`/biblia/${b.data.tema_slug || b.id}/`}
          badge={`${b.data.versiculos.length} pasajes meditados`}
        />
      ))}
    </div>

    <!-- Estudio Teológico y Exegético Destacado -->
    <div class="p-6 sm:p-8 rounded-2xl bg-amber-500/5 dark:bg-amber-400/5 border border-amber-500/20 flex flex-col md:flex-row md:items-center justify-between gap-6">
      <div class="space-y-2 max-w-2xl">
        <span class="text-xs uppercase tracking-widest font-mono text-amber-800 dark:text-amber-400 font-bold">
          Estudio Teológico Destacado
        </span>
        <h3 class="font-serif text-xl sm:text-2xl font-bold text-slate-900 dark:text-stone-100">
          El Misterio del Sufrimiento en la Biblia: De Job y la Cruz a Salvifici Doloris
        </h3>
        <p class="text-sm text-stone-600 dark:text-stone-300">
          Exégesis bíblica sobre el enigma del dolor inocente, la refutación de la retribución mecánica y la teología paulina de la redención.
        </p>
      </div>
      <a
        href="/biblia/el-misterio-del-sufrimiento-en-la-biblia/"
        class="inline-flex items-center justify-center px-5 py-3 rounded-xl bg-amber-600 hover:bg-amber-700 text-white font-medium text-sm transition-colors shrink-0"
      >
        Leer exégesis sobre el sufrimiento en la Biblia &rarr;
      </a>
    </div>
  </div>
</BaseLayout>
