---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import ArticleImage from '../../components/ui/ArticleImage.astro';

export async function getStaticPaths() {
  const santosEntries = await getCollection('santos');
  const filtered = santosEntries.filter(
    (entry) => entry.id !== 'estudios-medicos-y-santo-oficio' && !entry.data.santo_nombre?.includes('Pío')
  );
  return filtered.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : (import.meta.env.PUBLIC_SITE_URL || 'https://razonyasombro.com');
const isFaustina = entry.id === 'faustina-kowalska';
const alternateLinks = isFaustina ? [
  { hreflang: 'es', href: `${siteUrl}/santos/faustina-kowalska/` },
  { hreflang: 'en', href: `${siteUrl}/en/divine-mercy-chaplet/` },
  { hreflang: 'x-default', href: `${siteUrl}/santos/faustina-kowalska/` },
] : undefined;
const alternateUrl = isFaustina ? '/en/divine-mercy-chaplet/' : undefined;
---

<ArticleLayout
  title={entry.data.titulo}
  resumen={entry.data.resumen}
  badge={`Santos &middot; ${entry.data.eje_tematico}`}
  crumbs={[
    { label: 'Santos y Místicos', href: '/santos/' },
    { label: entry.data.titulo }
  ]}
  nextStepVariant="santos"
  fuentes={entry.data.fuentes}
  fechaPublicacion={entry.data.fecha_publicacion}
  fechaRevision={entry.data.fecha_revision}
  autor={entry.data.autor}
  revisadoPor={entry.data.revisado_por}
  imagen={entry.data.imagen}
  alternateLinks={alternateLinks}
  alternateUrl={alternateUrl}
>
  <Content components={{ ArticleImage }} />
</ArticleLayout>
