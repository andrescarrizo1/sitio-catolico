---
import BaseLayout from '../../layouts/BaseLayout.astro';

const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : (import.meta.env.PUBLIC_SITE_URL || 'https://razonyasombro.com');

const alternateLinks = [
  { hreflang: 'es', href: `${siteUrl}/` },
  { hreflang: 'en', href: `${siteUrl}/en/` },
  { hreflang: 'x-default', href: `${siteUrl}/` },
];

const websiteSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/en/#website`,
      'url': `${siteUrl}/en/`,
      'name': 'Reason & Wonder',
      'description': 'Catholic platform dedicated to proclaiming the truth of Jesus Christ, His biblical teachings, and documented signs of faith with historical and scientific rigor.',
      'inLanguage': 'en',
      'publisher': {
        '@id': `${siteUrl}/#organization`
      }
    },
    {
      '@type': 'Organization',
      '@id': `${siteUrl}/#organization`,
      'name': 'Reason & Wonder (Razón y Asombro)',
      'url': `${siteUrl}/`,
      'logo': {
        '@type': 'ImageObject',
        'url': `${siteUrl}/favicon.svg`
      },
      'description': 'Catholic platform for doctrinal dissemination, historical investigation of miracles, and contemplative prayer.'
    }
  ]
};

const pilotFeatures = [
  {
    title: 'Interactive Holy Rosary',
    description: 'Bead-by-bead visual guide with real-time progression tracking, Latin and bilingual texts, sacred audio chime, and offline PWA capability.',
    href: '/en/interactive-rosary/',
    badge: 'Interactive Prayer',
    icon: '📿',
  },
  {
    title: 'How to Pray the Rosary: Complete Guide',
    description: 'Detailed, canonical step-by-step instructions for beginners and seasoned faithful: prayers, mystery schedules, and contemplative method.',
    href: '/en/rosary/how-to-pray/',
    badge: 'Catechesis & Guide',
    icon: '📖',
  },
  {
    title: 'Forensic Science: The Shroud of Turin',
    description: 'Rigorous analysis of the 1978 STURP investigation, VP-8 3D encoding, male AB blood with trauma markers, and 2022 WAXS X-ray dating.',
    href: '/en/shroud-of-turin/',
    badge: 'Science & Faith',
    icon: '🔬',
  },
  {
    title: 'The Chaplet of Divine Mercy',
    description: 'Historical origins in Vilnius (1935), St. Faustina Kowalska’s Diary, the 3:00 PM Hour of Mercy, and how to pray on standard rosary beads.',
    href: '/en/divine-mercy-chaplet/',
    badge: 'Devotion & Saints',
    icon: '🕊️',
  },
];
---

<BaseLayout
  title="Reason & Wonder | Catholic Faith, Historical Rigor & Science"
  description="Catholic apologetics, forensic investigations (Shroud of Turin, Eucharistic Miracles), lives of saints, and interactive prayer tools with historical rigor."
  lang="en"
  alternateLinks={alternateLinks}
  alternateUrl="/"
>
  <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />

  <!-- Hero Section -->
  <section class="relative overflow-hidden bg-gradient-to-b from-stone-900 via-slate-950 to-stone-900 text-white py-16 sm:py-24 border-b border-stone-800">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-3xl space-y-6">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-semibold bg-amber-500/15 text-amber-300 border border-amber-500/30">
          <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
          Fides et Ratio &middot; Catholic Faith &amp; Scientific Rigor
        </div>

        <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-white leading-[1.15]">
          The Beauty of the Gospel.<br />
          <span class="text-amber-400">The Certainty of Facts.</span>
        </h1>

        <p class="text-lg sm:text-xl text-stone-300 font-reading leading-relaxed max-w-2xl">
          An uncompromising Catholic platform grounded in historical documentation, peer-reviewed scientific forensics, and deep contemplative prayer.
        </p>

        <div class="pt-4 flex flex-wrap gap-4 items-center">
          <a
            href="/en/interactive-rosary/"
            class="px-6 py-3 text-sm font-semibold rounded-xl bg-amber-600 hover:bg-amber-500 text-white shadow-lg shadow-amber-900/30 transition-all focus-visible:outline-2 focus-visible:outline-amber-400"
          >
            Launch Interactive Rosary &rarr;
          </a>
          <a
            href="/en/shroud-of-turin/"
            class="px-6 py-3 text-sm font-semibold rounded-xl bg-stone-800/80 hover:bg-stone-700/80 text-stone-200 border border-stone-700 transition-all focus-visible:outline-2 focus-visible:outline-stone-400"
          >
            Explore Shroud Forensics
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Pilot Features Section -->
  <section class="py-16 sm:py-20 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
    <div class="text-center max-w-2xl mx-auto space-y-3">
      <span class="text-xs font-semibold uppercase tracking-wider text-amber-700 dark:text-amber-400">
        English Edition Pilot
      </span>
      <h2 class="font-serif text-3xl sm:text-4xl font-bold text-slate-950 dark:text-stone-100">
        Essential Resources &amp; Research
      </h2>
      <p class="text-sm sm:text-base text-stone-600 dark:text-stone-400">
        Carefully curated research, step-by-step guides, and digital tools designed for spiritual growth and intellectual clarity.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
      {pilotFeatures.map((item) => (
        <a
          href={item.href}
          class="group block p-6 sm:p-8 rounded-2xl bg-stone-100/70 dark:bg-slate-900/70 border border-stone-200 dark:border-slate-800 hover:border-amber-600/40 dark:hover:border-amber-500/40 hover:shadow-xl transition-all"
        >
          <div class="flex items-center justify-between gap-4 mb-4">
            <span class="text-3xl">{item.icon}</span>
            <span class="px-3 py-1 rounded-full text-xs font-semibold bg-amber-500/10 text-amber-800 dark:text-amber-300 border border-amber-500/20">
              {item.badge}
            </span>
          </div>
          <h3 class="font-serif text-xl sm:text-2xl font-bold text-slate-950 dark:text-stone-100 group-hover:text-amber-700 dark:group-hover:text-amber-400 transition-colors mb-3">
            {item.title}
          </h3>
          <p class="text-sm text-stone-600 dark:text-stone-400 font-reading leading-relaxed">
            {item.description}
          </p>
          <div class="mt-4 inline-flex items-center gap-1.5 text-xs font-semibold text-amber-700 dark:text-amber-400 group-hover:gap-2.5 transition-all">
            Read complete guide <span>&rarr;</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Spanish Edition Notice -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <div class="p-8 rounded-2xl bg-gradient-to-r from-amber-500/10 via-amber-600/5 to-transparent border border-amber-500/20 flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="space-y-2 text-center md:text-left">
        <h3 class="font-serif text-lg sm:text-xl font-bold text-slate-950 dark:text-stone-100">
          Looking for the Spanish Edition?
        </h3>
        <p class="text-sm text-stone-600 dark:text-stone-400 max-w-xl">
          Our primary edition contains over 30 detailed historical investigations, Eucharistic miracle reports (Lanciano, Buenos Aires, Sokółka), apparitions of Our Lady of Fátima, and the Spiritual Comfort engine.
        </p>
      </div>
      <a
        href="/"
        class="px-5 py-2.5 text-xs font-semibold rounded-xl bg-amber-700 hover:bg-amber-600 text-white shadow-sm transition-colors whitespace-nowrap"
      >
        Ir a la edición en Español &rarr;
      </a>
    </div>
  </section>
</BaseLayout>
