---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RosaryApp from '../../components/rosario/RosaryApp.tsx';
import Breadcrumbs from '../../components/global/Breadcrumbs.astro';
import { Image } from 'astro:assets';
import rosarioHeroImg from '../../assets/rosario/rosario-manos-devocion.jpg';

// Schema.org FAQPage y HowTo para optimización máxima de SEO
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "¿Qué misterios del Rosario tocan hoy?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Según la distribución litúrgica oficial fijada por la carta apostólica Rosarium Virginis Mariae de San Juan Pablo II (2002): los Lunes y Sábados se rezan los Misterios Gozosos; los Martes y Viernes, los Misterios Dolorosos; los Miércoles y Domingos, los Misterios Gloriosos; y los Jueves, los Misterios Luminosos."
      }
    },
    {
      "@type": "Question",
      "name": "¿Cuántas cuentas tiene un rosario y cómo se distribuyen?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Un rosario tradicional de cinco decenas consta de 59 cuentas: un cordal inicial con el crucifijo, una cuenta gruesa (Padre Nuestro), tres cuentas pequeñas (tres Avemarías por la fe, esperanza y caridad) y la medalla conector; y un anillo de 5 decenas, cada una compuesta por una cuenta grande para el Padre Nuestro y diez cuentas pequeñas para el Ave María."
      }
    },
    {
      "@type": "Question",
      "name": "¿Cómo funciona este Rosario interactivo sin conexión a internet?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "La aplicación utiliza tecnología Progressive Web App (PWA) con un Service Worker que almacena los textos doctrinales, las oraciones bíblicas y el diagrama visual interactivo en la memoria local de tu dispositivo. Puedes rezar en modo avión, en iglesias sin cobertura o durante viajes con cero consumo de datos móviles."
      }
    },
    {
      "@type": "Question",
      "name": "¿Cuál es el valor espiritual de meditar el Santo Rosario?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "El Magisterio de la Iglesia enseña que el Rosario es un compendio del Evangelio. Su objetivo central no es la repetición mecánica de palabras, sino la contemplación silenciosa de los misterios salvíficos de la vida, pasión, muerte y resurrección de Jesucristo a través de la mirada y el corazón de la Virgen María."
      }
    }
  ]
};

const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "Cómo rezar el Santo Rosario paso a paso",
  "description": "Guía práctica y canónica para rezar el Santo Rosario con meditación bíblica, jaculatorias y letanías.",
  "step": [
    {
      "@type": "HowToStep",
      "position": 1,
      "name": "Señal de la Cruz y Credo Apostólico",
      "text": "Sostén el crucifijo, haz la señal de la cruz y reza el Credo profesando los dogmas fundamentales de la fe católica."
    },
    {
      "@type": "HowToStep",
      "position": 2,
      "name": "Oraciones Iniciales",
      "text": "En la primera cuenta grande reza un Padre Nuestro; en las siguientes tres cuentas pequeñas reza tres Avemarías pidiendo el aumento de la fe, la esperanza y la caridad; concluye con un Gloria."
    },
    {
      "@type": "HowToStep",
      "position": 3,
      "name": "Anuncio y Meditación del Misterio",
      "text": "Enuncia el primer misterio correspondiente al día, lee el pasaje de la Escritura o fruto espiritual, y reza un Padre Nuestro en la cuenta mayor."
    },
    {
      "@type": "HowToStep",
      "position": 4,
      "name": "Las Diez Avemarías de la Decena",
      "text": "Pasa cuenta por cuenta rezando diez Avemarías mientras mantienes la mente y el corazón centrados en el misterio anunciado."
    },
    {
      "@type": "HowToStep",
      "position": 5,
      "name": "Gloria al Padre y Jaculatoria de Fátima",
      "text": "Al culminar las diez Avemarías, reza el Gloria y añade la jaculatoria revelada a los tres pastorcitos en Cova da Iria: «Oh Jesús mío, perdónanos nuestros pecados...»."
    },
    {
      "@type": "HowToStep",
      "position": 6,
      "name": "Conclusión con la Salve Regina",
      "text": "Tras completar las cinco decenas, culmina rezando la Salve Regina y encomendando las intenciones de la Santa Iglesia y de la propia alma."
    }
  ]
};
---

<BaseLayout
  title="Santo Rosario Interactivo con Visor Visual de Cuentas | Razón y Asombro"
  description="Reza el Santo Rosario con un visor visual e interactivo cuenta por cuenta al lado del texto sagrado. Detección automática del misterio de hoy, audio litúrgico, latín/español y funcionamiento 100% offline."
  image="/images/rosario-manos-devocion.jpg"
>
  <!-- Inyección de Datos Estructurados JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8 space-y-8">
    
    <Breadcrumbs crumbs={[{ label: 'Santo Rosario' }]} />

    {/* Hero Superior Devocional con Fotografía y Tipografía Solemne */}
    <header class="relative rounded-3xl overflow-hidden bg-gradient-to-br from-stone-900 via-slate-950 to-stone-950 text-white p-6 sm:p-10 lg:p-12 shadow-xl border border-stone-800">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center relative z-10">
        
        <div class="lg:col-span-7 space-y-4">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-amber-500/20 text-amber-300 border border-amber-500/30">
            <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
            Modo Rezo Guiado &middot; Visor de Cuentas en Tiempo Real
          </div>

          <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-white leading-tight">
            El Santo Rosario Interactivo
          </h1>

          <p class="text-sm sm:text-base text-stone-300 max-w-xl font-reading leading-relaxed">
            Contempla los misterios de la salvación de la mano de la Santísima Virgen María. Sigue tu avance cuenta por cuenta con el diagrama visual interactivo, sonido litúrgico suave y textos bíblicos bilingües.
          </p>

          <div class="pt-2 flex flex-wrap items-center gap-4 text-xs font-medium">
            <a href="/rosario/como-rezar/" class="text-amber-400 hover:text-amber-300 underline underline-offset-4">
              ¿Cómo rezar el Rosario paso a paso? &rarr;
            </a>
            <span class="text-stone-500">&middot;</span>
            <a href="/rosario/misterios-de-hoy/" class="text-amber-400 hover:text-amber-300 underline underline-offset-4">
              Misterios recomendados para hoy &rarr;
            </a>
          </div>
        </div>

        <div class="lg:col-span-5 flex justify-center">
          <div class="relative w-full max-w-sm rounded-2xl overflow-hidden shadow-2xl border-2 border-amber-500/30 group">
            <Image
              src={rosarioHeroImg}
              alt="Manos orantes devotas sosteniendo un Santo Rosario de madera sobre una Biblia antigua con bordes dorados"
              widths={[320, 480, 640]}
              sizes="(max-width: 640px) 100vw, 400px"
              class="w-full h-56 sm:h-64 object-cover transition-transform duration-500 group-hover:scale-105"
              loading="eager"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-transparent flex items-end p-4">
              <span class="text-[11px] text-stone-300 font-serif italic">
                «La oración es la llave del corazón de Dios» &middot; Plegaria contemplativa
              </span>
            </div>
          </div>
        </div>

      </div>

    </header>

    {/* Aplicación Interactiva Principal (Isla Preact con renderizado a 2 columnas) */}
    <main class="my-8">
      <RosaryApp client:load />
    </main>

    {/* Sección Doctrinal y Bíblica Rastreable por Motores de Búsqueda (SEO Semantic HTML) */}
    <section class="mt-16 pt-12 border-t border-stone-200 dark:border-slate-800 space-y-12">
      
      <div class="max-w-3xl space-y-3">
        <span class="text-xs font-semibold uppercase tracking-wider text-amber-700 dark:text-amber-400">
          Catequesis y Fundamento Bíblico
        </span>
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-slate-950 dark:text-stone-100">
          Los Veinte Misterios del Santo Rosario
        </h2>
        <p class="text-sm text-stone-600 dark:text-stone-400 font-reading leading-relaxed">
          Cada misterio del Santo Rosario es una ventana a la vida de Nuestro Señor Jesucristo. Lejos de ser una repetición monótona, el rosario es una oración esencialmente cristológica y bíblica.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        
        {/* Misterios Gozosos */}
        <article class="p-6 rounded-2xl bg-stone-100/70 dark:bg-slate-900/70 border border-stone-200 dark:border-slate-800 space-y-4">
          <div class="flex items-center justify-between">
            <h3 class="font-serif text-lg font-bold text-slate-950 dark:text-stone-100 m-0">
              Misterios Gozosos
            </h3>
            <span class="px-2.5 py-1 rounded-full text-[11px] font-semibold bg-amber-500/10 text-amber-800 dark:text-amber-300">
              Lunes y Sábados
            </span>
          </div>
          <p class="text-xs text-stone-600 dark:text-stone-400">
            Celebran la Encarnación y la vida oculta de Jesús en el hogar de Nazaret:
          </p>
          <ol class="list-decimal pl-4 space-y-1.5 text-xs text-stone-700 dark:text-stone-300 font-reading">
            <li><strong>La Anunciación:</strong> La Encarnación del Verbo (Lc 1, 26-38). Fruto: Humildad.</li>
            <li><strong>La Visitación:</strong> María visita a su prima Santa Isabel (Lc 1, 39-56). Fruto: Caridad fraterna.</li>
            <li><strong>El Nacimiento:</strong> El Salvador nace en Belén (Lc 2, 1-20). Fruto: Desprendimiento.</li>
            <li><strong>La Presentación:</strong> Jesús es presentado en el Templo (Lc 2, 21-38). Fruto: Pureza y obediencia.</li>
            <li><strong>El Niño Hallado:</strong> Jesús entre los doctores (Lc 2, 41-52). Fruto: Búsqueda de Dios.</li>
          </ol>
        </article>

        {/* Misterios Dolorosos */}
        <article class="p-6 rounded-2xl bg-stone-100/70 dark:bg-slate-900/70 border border-stone-200 dark:border-slate-800 space-y-4">
          <div class="flex items-center justify-between">
            <h3 class="font-serif text-lg font-bold text-slate-950 dark:text-stone-100 m-0">
              Misterios Dolorosos
            </h3>
            <span class="px-2.5 py-1 rounded-full text-[11px] font-semibold bg-red-500/10 text-red-800 dark:text-red-300">
              Martes y Viernes
            </span>
          </div>
          <p class="text-xs text-stone-600 dark:text-stone-400">
            Meditan la Pasión y entrega expiatoria de Nuestro Señor hasta la Cruz:
          </p>
          <ol class="list-decimal pl-4 space-y-1.5 text-xs text-stone-700 dark:text-stone-300 font-reading">
            <li><strong>La Agonía en el Huerto:</strong> La oración en Getsemaní (Mt 26, 36-46). Fruto: Dolor de los pecados.</li>
            <li><strong>La Flagelación:</strong> Jesús atado a la columna (Jn 19, 1-3). Fruto: Mortificación de los sentidos.</li>
            <li><strong>La Coronación de Espinas:</strong> Las burlas de los soldados (Mt 27, 27-31). Fruto: Humildad moral.</li>
            <li><strong>La Cruz a Cuestas:</strong> El camino hacia el Calvario (Lc 23, 26-32). Fruto: Paciencia en el dolor.</li>
            <li><strong>La Crucifixión y Muerte:</strong> El sacrificio supremo (Jn 19, 17-30). Fruto: Salvación y perdón.</li>
          </ol>
        </article>

        {/* Misterios Gloriosos */}
        <article class="p-6 rounded-2xl bg-stone-100/70 dark:bg-slate-900/70 border border-stone-200 dark:border-slate-800 space-y-4">
          <div class="flex items-center justify-between">
            <h3 class="font-serif text-lg font-bold text-slate-950 dark:text-stone-100 m-0">
              Misterios Gloriosos
            </h3>
            <span class="px-2.5 py-1 rounded-full text-[11px] font-semibold bg-amber-500/10 text-amber-800 dark:text-amber-300">
              Miércoles y Domingos
            </span>
          </div>
          <p class="text-xs text-stone-600 dark:text-stone-400">
            Proclaman la victoria sobre el pecado, la muerte y la glorificación de la Iglesia:
          </p>
          <ol class="list-decimal pl-4 space-y-1.5 text-xs text-stone-700 dark:text-stone-300 font-reading">
            <li><strong>La Resurrección:</strong> El triunfo de la vida (Mt 28, 1-10). Fruto: Fe viva.</li>
            <li><strong>La Ascensión:</strong> Jesús asciende a los Cielos (Hch 1, 6-11). Fruto: Esperanza en la vida eterna.</li>
            <li><strong>Pentecostés:</strong> La venida del Espíritu Santo (Hch 2, 1-13). Fruto: Celo apostólico y amor a Dios.</li>
            <li><strong>La Asunción de María:</strong> Asunta en cuerpo y alma (Munificentissimus Deus). Fruto: Gracia de la perseverancia.</li>
            <li><strong>La Coronación de la Virgen:</strong> Reina de cielos y tierra (Ap 12, 1). Fruto: Confianza en su intercesión.</li>
          </ol>
        </article>

        {/* Misterios Luminosos */}
        <article class="p-6 rounded-2xl bg-stone-100/70 dark:bg-slate-900/70 border border-stone-200 dark:border-slate-800 space-y-4">
          <div class="flex items-center justify-between">
            <h3 class="font-serif text-lg font-bold text-slate-950 dark:text-stone-100 m-0">
              Misterios Luminosos
            </h3>
            <span class="px-2.5 py-1 rounded-full text-[11px] font-semibold bg-blue-500/10 text-blue-800 dark:text-blue-300">
              Jueves
            </span>
          </div>
          <p class="text-xs text-stone-600 dark:text-stone-400">
            Instituidos por San Juan Pablo II para contemplar la vida pública y ministerio de Jesús:
          </p>
          <ol class="list-decimal pl-4 space-y-1.5 text-xs text-stone-700 dark:text-stone-300 font-reading">
            <li><strong>El Bautismo en el Jordán:</strong> La revelación de la Trinidad (Mt 3, 13-17). Fruto: Fidelidad bautismal.</li>
            <li><strong>Las Bodas de Caná:</strong> El primer signo milagroso (Jn 2, 1-11). Fruto: Obediencia a Cristo por María.</li>
            <li><strong>El Anuncio del Reino:</strong> La llamada a la conversión (Mc 1, 14-15). Fruto: Arrepentimiento y penitencia.</li>
            <li><strong>La Transfiguración:</strong> La gloria en el Monte Tabor (Lc 9, 28-36). Fruto: Deseo de santidad interior.</li>
            <li><strong>La Institución de la Eucaristía:</strong> La Última Cena (Mt 26, 26-29). Fruto: Devoción eucarística viva.</li>
          </ol>
        </article>

      </div>

      {/* Preguntas Frecuentes (FAQ Accordion con Semántica Rastreable) */}
      <section class="space-y-6 pt-8">
        <div class="space-y-2">
          <span class="text-xs font-semibold uppercase tracking-wider text-amber-700 dark:text-amber-400">
            Dudas Habituales
          </span>
          <h2 class="font-serif text-2xl sm:text-3xl font-bold text-slate-950 dark:text-stone-100">
            Preguntas Frecuentes sobre el Santo Rosario
          </h2>
        </div>

        <div class="space-y-3">
          {faqSchema.mainEntity.map((faq) => (
            <details class="p-4 sm:p-5 rounded-2xl bg-stone-100/70 dark:bg-slate-900/70 border border-stone-200 dark:border-slate-800 group transition-all">
              <summary class="font-serif font-bold text-base text-slate-950 dark:text-stone-100 cursor-pointer list-none flex items-center justify-between">
                <span>{faq.name}</span>
                <span class="text-amber-600 dark:text-amber-400 group-open:rotate-180 transition-transform">
                  &darr;
                </span>
              </summary>
              <p class="mt-3 text-sm text-stone-600 dark:text-stone-300 font-reading leading-relaxed m-0 pt-2 border-t border-stone-200/50 dark:border-slate-800">
                {faq.acceptedAnswer.text}
              </p>
            </details>
          ))}
        </div>
      </section>

    </section>

  </div>
</BaseLayout>

