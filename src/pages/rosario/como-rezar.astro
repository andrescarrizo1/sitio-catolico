---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/global/Breadcrumbs.astro';
import { Image } from 'astro:assets';
import rosarioImg from '../../assets/rosario/rosario-manos-devocion.jpg';

const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "Cómo Rezar el Santo Rosario Paso a Paso",
  "description": "Instrucciones detalladas y canónicas para rezar el Santo Rosario católico: orden de oraciones, meditación de misterios y jaculatorias.",
  "image": "https://adveritatem.org/images/rosario-manos-devocion.jpg",
  "step": [
    {
      "@type": "HowToStep",
      "position": 1,
      "name": "Señal de la Cruz y Credo en el Crucifijo",
      "text": "Sostén el crucifijo con la mano derecha, santíguate diciendo «En el nombre del Padre, y del Hijo, y del Espíritu Santo» y reza el Credo de los Apóstoles."
    },
    {
      "@type": "HowToStep",
      "position": 2,
      "name": "Cuentas iniciales: Padre Nuestro y Tres Avemarías",
      "text": "En la primera cuenta grande reza un Padre Nuestro. En las siguientes tres cuentas pequeñas reza tres Avemarías pidiendo el aumento de la Fe, la Esperanza y la Caridad. Culmina con un Gloria."
    },
    {
      "@type": "HowToStep",
      "position": 3,
      "name": "Primer Misterio y Padre Nuestro",
      "text": "Anuncia el primer misterio del día (ej. La Anunciación), guarda un breve silencio de contemplación y reza un Padre Nuestro en la cuenta gruesa."
    },
    {
      "@type": "HowToStep",
      "position": 4,
      "name": "Diez Avemarías de la Primera Decena",
      "text": "Pasa una a una las diez cuentas pequeñas rezando diez Avemarías, fijando la mente en el misterio que se medita."
    },
    {
      "@type": "HowToStep",
      "position": 5,
      "name": "Gloria al Padre y Jaculatoria de Fátima",
      "text": "Al concluir la décima Avemaría, reza el Gloria y la oración enseñada por la Virgen en Fátima: «Oh Jesús mío, perdónanos nuestros pecados...»."
    },
    {
      "@type": "HowToStep",
      "position": 6,
      "name": "Repetición de las 4 Decenas Restantes y Salve Final",
      "text": "Repite los pasos 3 a 5 para el segundo, tercer, cuarto y quinto misterio. Al finalizar la quinta decena, concluye con la Salve Regina."
    }
  ]
};
---

<BaseLayout
  title="Cómo Rezar el Santo Rosario Paso a Paso | Guía Completa para Principiantes"
  description="Aprende a rezar el Santo Rosario católico paso a paso. Guía completa con orden de las oraciones: Credo, Padre Nuestro, Ave María, Gloria, Jaculatoria de Fátima y Salve."
  image="/images/rosario-manos-devocion.jpg"
>
  <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />

  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    
    <Breadcrumbs
      crumbs={[
        { label: 'Santo Rosario', href: '/rosario/' },
        { label: 'Cómo Rezar el Rosario' }
      ]}
    />

    <header class="mt-4 mb-10 space-y-4">
      <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-amber-500/10 text-amber-800 dark:text-amber-300 border border-amber-500/20">
        Catequesis Práctica &middot; Guía Paso a Paso
      </span>

      <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-slate-950 dark:text-stone-100 leading-[1.2]">
        Cómo Rezar el Santo Rosario Paso a Paso
      </h1>

      <p class="text-base sm:text-lg text-stone-600 dark:text-stone-300 font-reading leading-relaxed">
        El Rosario es una oración bíblica y contemplativa centrada en los misterios de la Redención de Nuestro Señor Jesucristo. Si estás comenzando a rezarlo o deseas repasar el orden formal de las oraciones, sigue esta guía estructurada.
      </p>

      {/* Tarjeta Visual de Acceso al Rosario Interactivo */}
      <div class="p-6 rounded-2xl bg-stone-100/80 dark:bg-slate-900/80 border border-stone-200 dark:border-slate-800 flex flex-col sm:flex-row items-center gap-5 my-6 shadow-sm">
        <div class="w-24 h-24 sm:w-28 sm:h-28 rounded-xl overflow-hidden shrink-0 border border-amber-500/30">
          <Image
            src={rosarioImg}
            alt="Santo Rosario en manos de oración"
            widths={[120, 240]}
            class="w-full h-full object-cover"
            loading="lazy"
          />
        </div>
        <div class="space-y-2 text-center sm:text-left">
          <h2 class="font-serif text-lg font-bold text-slate-950 dark:text-stone-100 m-0">
            ¿Prefieres rezar con guía visual en pantalla?
          </h2>
          <p class="text-xs text-stone-600 dark:text-stone-400 m-0 font-reading">
            Nuestro visor interactivo te muestra la cuenta exacta en la que estás sobre el diagrama del rosario, con audio de campanilla litúrgica y textos bilingües.
          </p>
          <div class="pt-1">
            <a
              href="/rosario/"
              class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-amber-600 text-white dark:bg-amber-500 dark:text-slate-950 font-bold text-xs shadow-sm hover:bg-amber-700 transition-colors"
            >
              Abrir Rosario Interactivo &rarr;
            </a>
          </div>
        </div>
      </div>
    </header>

    <div class="prose-editorial mx-auto space-y-8">
      
      {/* 1. Inicio en la Cruz */}
      <section class="p-6 sm:p-7 rounded-2xl bg-white dark:bg-slate-900 border border-stone-200 dark:border-slate-800 space-y-4 shadow-sm">
        <div class="flex items-center gap-3">
          <span class="w-7 h-7 rounded-full bg-amber-500/20 text-amber-800 dark:text-amber-300 font-serif font-bold text-sm flex items-center justify-center">
            1
          </span>
          <h2 class="font-serif text-xl font-bold text-slate-900 dark:text-stone-100 m-0">
            Inicio del Rosario (En la Cruz y cordal inicial)
          </h2>
        </div>
        
        <ol class="list-decimal pl-5 space-y-2 text-sm text-stone-700 dark:text-stone-300">
          <li><strong>La Señal de la Cruz:</strong> Sostén el crucifijo y santíguate diciendo: <em>«En el nombre del Padre, y del Hijo, y del Espíritu Santo. Amén»</em>.</li>
          <li><strong>El Credo de los Apóstoles:</strong> Reza el Credo completo profesando los dogmas esenciales de la fe cristiana.</li>
          <li><strong>Un Padre Nuestro:</strong> En la primera cuenta grande que sigue a la cruz.</li>
          <li><strong>Tres Avemarías:</strong> En las tres cuentas pequeñas siguientes, pidiendo a Dios el aumento de las tres virtudes teologales: la <strong>Fe</strong>, la <strong>Esperanza</strong> y la <strong>Caridad</strong>.</li>
          <li><strong>Un Gloria al Padre:</strong> Dando gracias y alabanza a la Santísima Trinidad.</li>
        </ol>
      </section>

      {/* 2. Las Cinco Decenas */}
      <section class="p-6 sm:p-7 rounded-2xl bg-white dark:bg-slate-900 border border-stone-200 dark:border-slate-800 space-y-4 shadow-sm">
        <div class="flex items-center gap-3">
          <span class="w-7 h-7 rounded-full bg-amber-500/20 text-amber-800 dark:text-amber-300 font-serif font-bold text-sm flex items-center justify-center">
            2
          </span>
          <h2 class="font-serif text-xl font-bold text-slate-900 dark:text-stone-100 m-0">
            El Desarrollo de las Cinco Decenas
          </h2>
        </div>

        <p class="text-sm text-stone-700 dark:text-stone-300">
          El rosario diario se compone de cinco decenas en torno a los misterios correspondientes al día. Por cada decena, se sigue este orden canónico:
        </p>

        <ol class="list-decimal pl-5 space-y-2 text-sm text-stone-700 dark:text-stone-300">
          <li><strong>Anuncio del Misterio:</strong> Se enuncia solemnemente el misterio (ej. <em>«Primer misterio gozoso: La encarnación del Hijo de Dios»</em>) y se guarda un breve espacio de meditación o lectura bíblica.</li>
          <li><strong>Un Padre Nuestro</strong> en la cuenta mayor separada.</li>
          <li><strong>Diez Avemarías</strong> recorriendo cada una de las diez cuentas pequeñas de la decena mientras se contempla el pasaje evangélico.</li>
          <li><strong>Un Gloria al Padre:</strong> <em>«Gloria al Padre, y al Hijo, y al Espíritu Santo...»</em>.</li>
          <li><strong>Jaculatoria de Fátima:</strong> <em>«¡Oh Jesús mío, perdónanos nuestros pecados, líbranos del fuego del infierno, lleva al cielo a todas las almas, especialmente a las más necesitadas de tu divina misericordia!»</em>.</li>
        </ol>
      </section>

      {/* 3. Conclusión */}
      <section class="p-6 sm:p-7 rounded-2xl bg-white dark:bg-slate-900 border border-stone-200 dark:border-slate-800 space-y-4 shadow-sm">
        <div class="flex items-center gap-3">
          <span class="w-7 h-7 rounded-full bg-amber-500/20 text-amber-800 dark:text-amber-300 font-serif font-bold text-sm flex items-center justify-center">
            3
          </span>
          <h2 class="font-serif text-xl font-bold text-slate-900 dark:text-stone-100 m-0">
            Conclusión del Rosario (Salve Regina)
          </h2>
        </div>

        <p class="text-sm text-stone-700 dark:text-stone-300">
          Al culminar la quinta decena en la medalla conector, se concluye con la oración de la <strong>Salve Regina</strong>:
        </p>

        <blockquote class="p-4 sm:p-5 rounded-xl bg-stone-50 dark:bg-slate-950 border-l-4 border-amber-600 dark:border-amber-400 text-sm font-reading italic text-stone-800 dark:text-stone-200">
          &laquo;Dios te salve, Reina y Madre de misericordia, vida, dulzura y esperanza nuestra; Dios te salve. A ti llamamos los desterrados hijos de Eva; a ti suspiramos, gimiendo y llorando, en este valle de lágrimas. Ea, pues, Señora, abogada nuestra, vuelve a nosotros esos tus ojos misericordiosos; y después de este destierro muéstranos a Jesús, fruto bendito de tu vientre. ¡Oh clemente, oh piadosa, oh dulce Virgen María! Ruega por nosotros, Santa Madre de Dios, para que seamos dignos de alcanzar las promesas de Nuestro Señor Jesucristo. Amén.&raquo;
        </blockquote>

        <p class="text-xs text-stone-500 dark:text-stone-400 pt-2">
          De forma voluntaria, pueden añadirse las <em>Letanías Lauretanas</em> y encomendar las intenciones del Santo Padre rezando un Padre Nuestro, un Avemaría y un Gloria.
        </p>
      </section>

    </div>
  </div>
</BaseLayout>
