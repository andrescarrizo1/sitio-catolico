---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RosaryApp from '../../components/rosario/RosaryApp.tsx';
import Breadcrumbs from '../../components/global/Breadcrumbs.astro';
import FaqAccordion from '../../components/ui/FaqAccordion.astro';
import NextStep from '../../components/ui/NextStep.astro';

const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : (import.meta.env.PUBLIC_SITE_URL || 'https://razonyasombro.com');
const currentURL = `${siteUrl}/rosario/misterios-de-hoy/`;

const alternateLinks = [
  { hreflang: 'es', href: currentURL },
  { hreflang: 'x-default', href: currentURL },
];

const misteriosFaq = [
  {
    question: "¿Qué misterios del Rosario se rezan hoy según el día de la semana?",
    answer: "Conforme a la Carta Apostólica Rosarium Virginis Mariae de San Juan Pablo II (2002), el calendario semanal oficial de la Iglesia Católica es: Lunes y Sábados: Misterios Gozosos; Martes y Viernes: Misterios Dolorosos; Miércoles y Domingos: Misterios Gloriosos; Jueves: Misterios Luminosos."
  },
  {
    question: "¿Se puede rezar un misterio diferente al que corresponde hoy?",
    answer: "Sí, absolutamente. La Iglesia propone la distribución semanal como una guía para recorrer ordenadamente toda la vida de Cristo, pero no como una obligación bajo pena de pecado. Puedes rezar cualquier grupo de misterios según tu devoción particular, la fiesta litúrgica del día o tus necesidades espirituales (por ejemplo, rezar los Misterios Dolorosos ante una prueba personal, o los Gozosos en Navidad)."
  },
  {
    question: "¿Qué misterios se rezan tradicionalmente los domingos?",
    answer: "De ordinario se rezan los Misterios Gloriosos, ya que el domingo es el Día del Señor en memoria perpetua de la Resurrección. No obstante, existe la piadosa costumbre eclesial de rezar los Misterios Gozosos los domingos de Adviento y Navidad, y los Misterios Dolorosos los domingos de Cuaresma."
  },
  {
    question: "¿Por qué los Misterios Luminosos se rezan los jueves?",
    answer: "San Juan Pablo II fijó el jueves para los Misterios Luminosos porque en ese grupo se contempla la Institución de la Eucaristía en la Última Cena, acontecimiento que la Iglesia conmemora semanalmente cada Jueves Santo. Además, esto permitió reasignar el sábado a los Misterios Gozosos, día tradicionalmente consagrado a la Virgen María."
  },
  {
    question: "¿Cómo funciona el visor interactivo de esta página?",
    answer: "Al abrir esta página, el sistema detecta de forma automática el día de la semana configurado en tu teléfono móvil o computadora y precarga los misterios bíblicos correspondientes a hoy. Puedes comenzar a rezar de inmediato cuenta por cuenta, o cambiar manualmente de misterio mediante los botones del visor."
  }
];

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Misterios del Rosario de Hoy: Asignación Diaria y Rezo Guiado",
  "url": currentURL,
  "description": "Descubre qué misterios del Santo Rosario tocan rezar hoy según el día de la semana: Gozosos, Luminosos, Dolorosos o Gloriosos, con citas bíblicas y visor interactivo.",
  "inLanguage": "es"
};
---

<BaseLayout
  title="Misterios del Rosario de Hoy | Razón y Asombro"
  description="Misterios del Rosario para hoy según el día de la semana: Gozosos, Luminosos, Dolorosos o Gloriosos con asignación litúrgica, citas bíblicas y rezo interactivo."
  image="/images/rosario-manos-devocion.jpg"
  alternateLinks={alternateLinks}
>
  <script type="application/ld+json" set:html={JSON.stringify(webPageSchema)} />

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8 space-y-8">
    
    <Breadcrumbs
      crumbs={[
        { label: 'Santo Rosario', href: '/rosario/' },
        { label: 'Misterios de Hoy' }
      ]}
    />
    
    <!-- Encabezado Principal Orientado a la Búsqueda Diaria -->
    <header class="text-center my-6 space-y-4 max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-amber-500/10 text-amber-800 dark:text-amber-300 border border-amber-600/30">
        <span class="w-2 h-2 rounded-full bg-amber-500 animate-pulse"></span>
        Detección Litúrgica Automática en Vivo
      </div>

      <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-slate-950 dark:text-stone-100 leading-tight">
        ¿Qué Misterios del Rosario Tocan Rezar Hoy?
      </h1>

      <p class="text-base sm:text-lg text-stone-600 dark:text-stone-300 font-reading leading-relaxed">
        La Iglesia Católica asigna cada día de la semana a una etapa de la vida de Nuestro Señor Jesucristo y de la Virgen María. Consulta a continuación la distribución litúrgica oficial y reza de inmediato con el visor interactivo guiado:
      </p>
    </header>

    <!-- Tarjetas Interactivas de los 7 Días de la Semana con Enlaces a Guías Completas -->
    <section aria-label="Asignación Semanal de Misterios" class="space-y-4">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        
        <!-- Lunes y Sábados: Gozosos -->
        <div class="p-5 rounded-2xl bg-stone-100/80 dark:bg-slate-900/80 border border-amber-500/30 shadow-xs flex flex-col justify-between space-y-3">
          <div>
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold uppercase tracking-wider text-amber-700 dark:text-amber-400">
                Lunes y Sábados
              </span>
              <span class="px-2 py-0.5 rounded-full text-[10px] font-semibold bg-amber-500/20 text-amber-900 dark:text-amber-200">
                Encarnación
              </span>
            </div>
            <h2 class="font-serif text-xl font-bold text-slate-950 dark:text-stone-100 mt-1 mb-2">
              Misterios Gozosos
            </h2>
            <p class="text-xs text-stone-600 dark:text-stone-400 leading-relaxed font-reading">
              La Anunciación, la Visitación a Isabel, el Nacimiento en Belén, la Presentación en el Templo y el Niño Jesús hallado entre los doctores.
            </p>
          </div>
          <div class="pt-2 border-t border-stone-200/60 dark:border-slate-800">
            <a href="/rosario/misterios-gozosos/" class="inline-flex items-center gap-1 text-xs font-bold text-amber-700 dark:text-amber-400 hover:underline">
              <span>Leer meditación bíblica completa</span> &rarr;
            </a>
          </div>
        </div>

        <!-- Martes y Viernes: Dolorosos -->
        <div class="p-5 rounded-2xl bg-stone-100/80 dark:bg-slate-900/80 border border-red-500/30 shadow-xs flex flex-col justify-between space-y-3">
          <div>
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold uppercase tracking-wider text-red-700 dark:text-red-400">
                Martes y Viernes
              </span>
              <span class="px-2 py-0.5 rounded-full text-[10px] font-semibold bg-red-500/20 text-red-900 dark:text-red-200">
                Pasión
              </span>
            </div>
            <h2 class="font-serif text-xl font-bold text-slate-950 dark:text-stone-100 mt-1 mb-2">
              Misterios Dolorosos
            </h2>
            <p class="text-xs text-stone-600 dark:text-stone-400 leading-relaxed font-reading">
              La Oración en Getsemaní, la Flagelación en la Columna, la Coronación de Espinas, la Cruz a Cuestas y la Crucifixión y Muerte en el Calvario.
            </p>
          </div>
          <div class="pt-2 border-t border-stone-200/60 dark:border-slate-800">
            <a href="/rosario/misterios-dolorosos/" class="inline-flex items-center gap-1 text-xs font-bold text-red-700 dark:text-red-400 hover:underline">
              <span>Leer meditación bíblica completa</span> &rarr;
            </a>
          </div>
        </div>

        <!-- Miércoles y Domingos: Gloriosos -->
        <div class="p-5 rounded-2xl bg-stone-100/80 dark:bg-slate-900/80 border border-amber-500/30 shadow-xs flex flex-col justify-between space-y-3">
          <div>
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold uppercase tracking-wider text-amber-700 dark:text-amber-400">
                Miércoles y Domingos
              </span>
              <span class="px-2 py-0.5 rounded-full text-[10px] font-semibold bg-amber-500/20 text-amber-900 dark:text-amber-200">
                Pascua
              </span>
            </div>
            <h2 class="font-serif text-xl font-bold text-slate-950 dark:text-stone-100 mt-1 mb-2">
              Misterios Gloriosos
            </h2>
            <p class="text-xs text-stone-600 dark:text-stone-400 leading-relaxed font-reading">
              La Resurrección de Jesús, la Ascensión a los Cielos, la Venida del Espíritu Santo en Pentecostés, la Asunción de María y su Coronación como Reina.
            </p>
          </div>
          <div class="pt-2 border-t border-stone-200/60 dark:border-slate-800">
            <a href="/rosario/misterios-gloriosos/" class="inline-flex items-center gap-1 text-xs font-bold text-amber-700 dark:text-amber-400 hover:underline">
              <span>Leer meditación bíblica completa</span> &rarr;
            </a>
          </div>
        </div>

        <!-- Jueves: Luminosos -->
        <div class="p-5 rounded-2xl bg-stone-100/80 dark:bg-slate-900/80 border border-blue-500/30 shadow-xs flex flex-col justify-between space-y-3">
          <div>
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold uppercase tracking-wider text-blue-700 dark:text-blue-400">
                Jueves
              </span>
              <span class="px-2 py-0.5 rounded-full text-[10px] font-semibold bg-blue-500/20 text-blue-900 dark:text-blue-200">
                Vida Pública
              </span>
            </div>
            <h2 class="font-serif text-xl font-bold text-slate-950 dark:text-stone-100 mt-1 mb-2">
              Misterios Luminosos
            </h2>
            <p class="text-xs text-stone-600 dark:text-stone-400 leading-relaxed font-reading">
              El Bautismo en el Jordán, las Bodas de Caná, el Anuncio del Reino de Dios, la Transfiguración en el Monte Tabor y la Institución de la Eucaristía.
            </p>
          </div>
          <div class="pt-2 border-t border-stone-200/60 dark:border-slate-800">
            <a href="/rosario/misterios-luminosos/" class="inline-flex items-center gap-1 text-xs font-bold text-blue-700 dark:text-blue-400 hover:underline">
              <span>Leer meditación bíblica completa</span> &rarr;
            </a>
          </div>
        </div>

      </div>
    </section>

    <!-- Visor Interactivo Guiado de Rezo en Pantalla -->
    <section class="my-10 space-y-4">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-stone-200 dark:border-slate-800 pb-3">
        <div>
          <h2 class="font-serif text-2xl font-bold text-slate-950 dark:text-stone-100 m-0">
            Reza Ahora con el Visor Visual Interactivo
          </h2>
          <p class="text-xs text-stone-500 dark:text-stone-400 m-0">
            Avanza cuenta por cuenta con audio suave, citas bíblicas y oraciones completas en español o latín.
          </p>
        </div>
        <div class="flex items-center gap-2">
          <a
            href="/rosario/como-rezar/"
            class="text-xs font-semibold text-amber-700 dark:text-amber-400 hover:underline"
          >
            ¿Cómo rezar paso a paso? &rarr;
          </a>
        </div>
      </div>

      <main class="mt-4">
        <RosaryApp client:load />
      </main>
    </section>

    <!-- Fundamento Pastoral e Histórico de la Asignación Semanal -->
    <section class="p-6 sm:p-8 rounded-2xl bg-stone-100/70 dark:bg-slate-900/70 border border-stone-200 dark:border-slate-800 space-y-4 leading-relaxed font-reading text-sm sm:text-base text-stone-700 dark:text-stone-300">
      <h2 class="font-serif text-2xl font-bold text-slate-950 dark:text-stone-100">
        ¿Por qué la Iglesia distribuye los misterios de esta manera?
      </h2>
      <p>
        El Rosario es un <em>compendio del Evangelio</em>. San Juan Pablo II explicó en su Carta Apostólica <em>Rosarium Virginis Mariae</em> (2002) que repartir los misterios en los distintos días de la semana ayuda a que el fiel cristiano «respire el ritmo de la vida de Cristo» en su vida cotidiana:
      </p>
      <ul class="list-disc pl-5 space-y-2 text-stone-600 dark:text-stone-400 text-sm">
        <li><strong>Lunes y Sábados (Gozosos):</strong> Al comenzar la semana laboral, la Encarnación y la vida oculta de Nazaret recuerdan la santificación del trabajo diario. El sábado, día tradicionalmente mariano en la Iglesia, nos une a la Virgen en la espera orante.</li>
        <li><strong>Martes y Viernes (Dolorosos):</strong> El martes continúa la profundización en la entrega redentora, y el viernes nos une espiritualmente al sacrificio del Calvario en el día en que Cristo murió por nuestros pecados.</li>
        <li><strong>Miércoles y Domingos (Gloriosos):</strong> El domingo es la Pascua semanal de la Iglesia, fiesta solemne de la Resurrección. El miércoles actúa como recordatorio intermedio de la victoria de Cristo sobre la muerte.</li>
        <li><strong>Jueves (Luminosos):</strong> Día eucarístico por excelencia, conmemoración semanal de la Última Cena y de la entrega sacerdotal de Jesús antes del Getsemaní.</li>
      </ul>
    </section>

    <!-- Sección de Preguntas Frecuentes con Componente Reutilizable -->
    <FaqAccordion
      title="Preguntas Frecuentes sobre los Misterios de Hoy"
      subtitle="Respuestas claras y fundamentadas a las dudas habituales al rezar el Rosario cotidiano."
      items={misteriosFaq}
    />

    <!-- Siguiente Paso y Muro de Oración -->
    <NextStep
      variant="jesus"
      customTitle="Presenta tus Intenciones de Hoy en el Muro de Oración"
      customAction="Al concluir el rezo de tu Rosario, une tus peticiones y acciones de gracias a las intenciones de toda la comunidad católica en nuestro Muro de Oración."
    />

  </div>
</BaseLayout>
