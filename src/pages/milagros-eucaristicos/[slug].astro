---
import { getCollection, render } from 'astro:content';
import FactLayout from '../../layouts/FactLayout.astro';
import ArticleImage from '../../components/ui/ArticleImage.astro';

export async function getStaticPaths() {
  const milagrosEntries = await getCollection('milagros');
  return milagrosEntries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<FactLayout
  title={entry.data.titulo}
  resumen={entry.data.resumen}
  badge="Milagro Eucarístico &middot; Ciencia"
  crumbs={[
    { label: 'Milagros Eucarísticos', href: '/milagros-eucaristicos/' },
    { label: entry.data.titulo }
  ]}
  lugar={entry.data.lugar}
  fechaEvento={entry.data.fecha_evento}
  estatusEclesial={entry.data.estatus_eclesial}
  evidenciaCientifica={entry.data.evidencia_cientifica_resumen}
  grupoSanguineo={entry.data.grupo_sanguineo}
  investigadores={entry.data.investigadores_clave}
  laboratorios={entry.data.laboratorios_participantes}
  fuentes={entry.data.fuentes}
  nextStepVariant="milagros"
  fechaPublicacion={entry.data.fecha_publicacion}
  fechaRevision={entry.data.fecha_revision}
  autor={entry.data.autor}
  revisadoPor={entry.data.revisado_por}
  imagen={entry.data.imagen}
>
  <Content components={{ ArticleImage }} />
</FactLayout>
