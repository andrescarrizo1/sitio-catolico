{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sitio-catolico",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-27",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": false
  },
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true
  }
}
